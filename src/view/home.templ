package view

import (
	"strconv"

	"github.com/dechristopher/lio/message"
	"github.com/dechristopher/lio/news"
	"github.com/dechristopher/lio/prefs"
	"github.com/dechristopher/lio/title"
)

// HomeActivity is the live region of the home page: the site stat counters, the
// joinable open challenges, and the players panel.
//
// It is **server-rendered once and streamed thereafter**
// (arch/HOME_ACTIVITY_STREAMING.md). This component paints it; every update
// after that arrives over the /socket/home WebSocket as JSON and is applied by
// lio-home.js. It used to poll /home/activity every 5s via htmx, which
// re-derived the whole site picture once per viewer and made the presence walk
// O(V²).
//
// Because two renderers now draw the same region, the markup below carries
// stable ids and always renders each section's shell — hidden when empty rather
// than absent — so the client patches rows into a structure that is already
// there instead of rebuilding cards. Keep the ids and the row markup in step
// with lio-home.js; a class added here and not there shows up as a row that
// changes shape the first time the socket refreshes it.
//
// The live-games grid is NOT here. It streams over the same socket (see
// tvWidget / lio-tv.js) and stays outside this region because its boards are
// octadground instances that must not be re-created by a text patch.
templ HomeActivity(challenges []message.OpenChallenge, stats message.SiteStats, community message.Community) {
	<section id="home-activity" class="flex flex-col gap-4">
		@siteStats(stats)
		@openChallenges(challenges)
		@playersCard(community)
	</section>
}

// siteStats renders the three live counters as a compact stat strip.
templ siteStats(stats message.SiteStats) {
	<div class="grid grid-cols-3 gap-2.5">
		@statTile(stats.Playing, "Online", "home-stat-playing")
		@statTile(stats.LiveGames, "Live", "home-stat-live")
		@statTile(stats.TotalGames, "Games", "home-stat-total")
	</div>
}

// statTile is one counter. The id is on the number rather than on the tile: the
// stream only ever changes the figure, and patching the smallest node that can
// change is what keeps the label from flickering.
templ statTile(n int, label string, id string) {
	<div class="card flex flex-col items-center gap-0.5 py-3">
		<span id={ id } class="font-display text-2xl font-bold leading-none text-accent">{ strconv.Itoa(n) }</span>
		<span class="text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">{ label }</span>
	</div>
}

// openChallenges lists human-vs-human rooms waiting for an opponent. Each links
// to the room page, where the visitor is offered the open seat.
templ openChallenges(challenges []message.OpenChallenge) {
	<div class="card">
		<div class="flex items-center justify-between">
			<p class="font-display text-lg font-bold text-fg">Open challenges</p>
			<button type="button" data-open-create-game data-prefill-public class="text-xs font-semibold text-accent hover:underline cursor-pointer">+ New</button>
		</div>
		// Both states are always present and one is hidden, so the stream can
		// swap between them without the card resizing around a node that does
		// not exist yet.
		<p
			id="home-challenges-empty"
			class="mt-1 text-sm text-fg-subtle"
			if len(challenges) > 0 {
				hidden
			}
		>No open challenges right now — <button type="button" data-open-create-game data-prefill-public class="font-semibold text-accent hover:underline cursor-pointer">create one</button> to get a game going</p>
		<ul
			id="home-challenges-list"
			class="mt-3 flex flex-col gap-2"
			if len(challenges) == 0 {
				hidden
			}
		>
			for _, c := range challenges {
				@challengeRow(c)
			}
		</ul>
	</div>
}

// challengeRow is one open seek. lio-home.js builds this same row from the
// streamed HomeChallenge — keep the two in step.
templ challengeRow(c message.OpenChallenge) {
	<li>
		<a href={ templ.SafeURL("/" + c.RoomID) } class="flex items-center justify-between gap-3 rounded-md border border-line bg-panel px-3 py-2.5 no-underline transition duration-150 ease-snappy hover:-translate-y-px hover:border-accent hover:shadow-md">
			<span class="flex min-w-0 items-center gap-2.5">
				@colorDot(c.Color)
				<span class="flex min-w-0 flex-col leading-tight">
					<span class="flex items-center gap-1.5">
						@challengerName(c)
						if c.Rated {
							// rated seeks are members-only; anons see the tag and log in to join
							<span class="inline-flex flex-none items-center gap-0.5 rounded-full border border-accent/40 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-accent">
								@iconTrophy("h-2.5 w-2.5")
								Rated
							</span>
						}
					</span>
					<span class="text-[11px] uppercase tracking-wide text-fg-subtle">
						// SpeedGroup, not Group: every seek is a deploy variant, so Group
						// is the constant "deploy" and says nothing — the speed class is
						// what a player reads a challenge by
						{ c.Variant.Name } · { c.Variant.SpeedGroup().String() }
						if c.RaceTo > 0 {
							· race to { strconv.Itoa(c.RaceTo) }
						}
					</span>
				</span>
			</span>
			if c.Rated && !viewer(ctx).LoggedIn {
				<span class="btn btn-ghost flex-none px-3 py-1.5 text-xs">Log in</span>
			} else {
				<span class="btn btn-primary flex-none px-3 py-1.5 text-xs">Join</span>
			}
		</a>
	</li>
}

// challengerName is a seek's headline: who is waiting. A named account gets its
// title badge, username and (for a rated seek) rating; an anonymous creator gets
// a muted "Anonymous". Putting the person on the primary line and demoting the
// time control to the sub-line is deliberate — a challenge is an invitation from
// somebody, and the visible difference between a name and "Anonymous" is the
// most honest argument the page makes for holding an account.
templ challengerName(c message.OpenChallenge) {
	if c.CreatorName != "" {
		@playerTitle(c.CreatorTitle)
		<span class="truncate text-sm font-semibold text-fg">{ c.CreatorName }</span>
		if c.CreatorRating != "" {
			<span class="rating-chip flex-none">{ c.CreatorRating }</span>
		}
	} else {
		<span class="truncate text-sm font-semibold text-fg-muted">Anonymous</span>
	}
}

// playersCard is the home page's people panel: who is here now, and who just
// joined.
//
// Every section's shell renders whether or not it has content, and empties are
// hidden rather than absent. The stream patches rows into these lists
// (lio-home.js), and a section that only exists when the server happened to
// have something for it would leave the client with nowhere to put the first
// arrival. The card itself is hidden the same way, so a site with nobody on it
// still looks quiet rather than broken.
//
// It holds no client-side state — no tab strip, sections stacked — which was
// originally forced by the 5s htmx swap and is kept now because the sections
// are independent lists rather than views of one list.
templ playersCard(c message.Community) {
	<div
		id="home-players"
		class="card"
		if !hasPlayers(c) {
			hidden
		}
	>
		// no header link: there is no player directory to point at yet, and a
		// heading link that goes somewhere unrelated is worse than none
		<p class="font-display text-lg font-bold text-fg">Players</p>
		// The viewer's own follows who are here, above the site-wide roster
		// (arch/FOLLOWING.md). These names are removed from the roster below rather
		// than repeated there — the two lists are one roster split by whether
		// the viewer cares, and a name in both would read as two people.
		//
		// This section is the one part of the region that is NOT broadcast: it
		// arrives per socket, because resolving it needs the viewer's follow set
		// (arch/HOME_ACTIVITY_STREAMING.md). The client also removes its names
		// from the roster below, which the server did before the split.
		<div
			id="home-following"
			if len(c.Following) == 0 {
				hidden
			}
		>
			<p class="roster-label roster-label-following">Following</p>
			<ul id="home-following-list" class="chip-list">
				for _, m := range c.Following {
					@rosterChip(m)
				}
			</ul>
		</div>
		<div
			id="home-online"
			if len(c.Online) == 0 {
				hidden
			}
		>
			// "Active", not "Online now": the list covers a window, and most of
			// it is usually people who are here this second. The footnote below
			// states the window, which is what makes an undotted chip legible.
			<p class="roster-label">Active</p>
			<ul id="home-online-list" class="chip-list">
				for _, m := range c.Online {
					@rosterChip(m)
				}
			</ul>
		</div>
		<p
			id="home-anon"
			class="roster-note"
			if rosterNote(c, viewer(ctx).LoggedIn) == "" {
				hidden
			}
		>{ rosterNote(c, viewer(ctx).LoggedIn) }</p>
		<div
			id="home-arrivals"
			if len(c.Newest) == 0 {
				hidden
			}
		>
			<p class="roster-label">Arrivals</p>
			<ul id="home-arrivals-list" class="chip-list">
				for _, m := range c.Newest {
					@arrivalChip(m)
				}
			</ul>
		</div>
	</div>
}

// arrivalChip is one recently registered account. The chip shows the join date
// in its token form ("2d"); the prose form rides in the tooltip, so nothing is
// lost to the abbreviation for anyone who hovers.
//
// Both strings are computed here on the first paint and sent pre-formatted on
// every streamed one (view.HomeDigest), so the two renderers cannot word the
// same relative time differently.
//
// An arrival who is on the site right now carries the full roster treatment —
// dot, state tag, and a sword when they are free. A new player who is here and
// available is the best challenge target the page has, and before this the
// section could not say which of them that was.
templ arrivalChip(m message.NewMember) {
	@playerChip(m.Username, m.Title, m.Online, m.Playing, m.Busy,
		shortAgo(m.Joined), "joined "+RelativeDay(m.Joined))
}

// rosterChip is one player in the players card: a split pill whose name links
// to their profile and whose sword opens a challenge. Two targets that read as
// a single object, which is what they are — a person and what you can do with
// them.
//
// Shared by the "Following" and "Active" sections so the two cannot drift:
// a followed player and a stranger are the same kind of row, and the only
// difference between the lists is which of them the viewer chose to see first
// (arch/FOLLOWING.md).
//
// The dot used to be unconditional here, because being in one of these lists
// meant holding a socket. The lists now cover presence.ActiveWindow, so a row
// may be somebody who has just gone: no dot, no sword, and a token saying how
// long ago. That is the same treatment an offline arrival has always had, which
// is why one component still renders all three lists.
templ rosterChip(m message.OnlineMember) {
	@playerChip(m.Username, m.Title, m.Online, m.Playing, m.Busy,
		shortSince(m.Left), leftPhrase(m.Left))
}

// playerChip is the one chip renderer, shared by every list in the players card:
// the Following and Active rosters, and the Arrivals list.
//
// One component rather than two because they are the same object — a person and
// what you can do with them. A followed player, a stranger and a new arrival
// differ only in which list surfaced them, and the Arrivals chips used to be a
// separate, simpler pill that could not say whether the new player was even
// here. lio-home.js has a single builder mirroring this one, for the same
// reason (arch/HOME_ACTIVITY_STREAMING.md).
//
// online is what decides whether the presence dot renders at all. On the two
// rosters it is always true; in Arrivals most rows are people who registered and
// left, and a dot on every chip would be a marker that usually says nothing. The
// dot is therefore a distinction, exactly as the tag below is.
//
// when / whenTitle are the Arrivals join token ("2d") and its tooltip; empty on
// the rosters, where the section itself already says when.
templ playerChip(username string, t title.Title, online, playing, busy bool, when, whenTitle string) {
	<li class="roster-item">
		<a
			href={ templ.SafeURL(profileURL(username)) }
			class={ "roster-chip", templ.KV("is-playing", playing), templ.KV("is-busy", busy) }
			if whenTitle != "" {
				title={ whenTitle }
			}
		>
			if online {
				<span class="roster-dot" aria-hidden="true"></span>
			}
			@playerTitle(t)
			<span class="roster-chip-name">{ username }</span>
			// Only the unavailable members carry a tag, so it reads as a
			// distinction rather than noise repeated on every chip. It is text,
			// not just the amber dot, so the state never depends on color alone
			// — and it says why the sword is missing rather than leaving that
			// to be inferred.
			if playing {
				<span class="roster-chip-tag">playing</span>
			} else if busy {
				<span class="roster-chip-tag">waiting</span>
			}
			if when != "" {
				<span class="roster-chip-when">{ when }</span>
			}
		</a>
		// The sword is a sibling of the chip, not a child: the chip is a link to
		// their profile, and a button inside an anchor is neither valid nor
		// clickable in the way either one wants. The two are joined into one
		// pill by the CSS.
		//
		// It appears only for somebody who could actually accept right now — see
		// canChallenge, which now takes the presence flag itself, so every list
		// gets the rule rather than each caller remembering to guard. A control
		// that is present but fails is worse than one that is absent.
		if canChallenge(viewer(ctx), username, online, busy) {
			@challengeButton(username, "roster-challenge")
		}
	</li>
}

// leaderboardCard is the rating board in the home page's right column. It shows
// one row per account (their best established rating), and only ratings that
// have stopped being provisional — a board topped by players who have never
// finished a game would rank noise.
//
// It sits outside the polled activity region on purpose: a leaderboard does not
// move on a 5-second timescale, and re-rendering it with the roster would buy
// nothing.
templ leaderboardCard(c message.Community) {
	if len(c.Top) > 0 {
		<div class="card">
			<div class="flex items-center justify-between">
				<h2 class="font-display text-lg font-bold text-fg">Top rated</h2>
				<span class="text-[11px] uppercase tracking-wide text-fg-subtle">Any time control</span>
			</div>
			<ol class="roster mt-1">
				for i, m := range c.Top {
					<li>
						<a href={ templ.SafeURL(profileURL(m.Username)) } class="roster-row">
							<span class="roster-rank">{ strconv.Itoa(i + 1) }</span>
							<span class="roster-name">
								@playerTitle(m.Title)
								<span class="truncate">{ m.Username }</span>
							</span>
							<span class="roster-rating">{ ratingLine(m) }</span>
						</a>
					</li>
				}
			</ol>
		</div>
	}
}

// homeWelcome is the anonymous visitor's account pitch: the home-page
// counterpart to the room page's thin roomAnonCta shim, given room to make an
// actual case (a rating, a profile, a name others can find and challenge).
// Gated to logged-out viewers where accounts exist, so it never shows to a
// member or in PG-less local dev.
//
// Dismissal persists exactly like the room shim's: the × writes localStorage
// and the head no-flash script stamps html[data-homecta="off"] before first
// paint, so a closed card never flashes back on the next load.
templ homeWelcome() {
	if !viewer(ctx).LoggedIn && viewer(ctx).AccountsEnabled {
		<div id="homeCta" class="card home-cta" role="region" aria-label="Create a free account">
			<button type="button" id="homeCtaDismiss" class="home-cta-x" aria-label="Dismiss" title="Dismiss">
				@iconClose()
			</button>
			<h2 class="font-display text-lg font-bold text-fg">Play as someone</h2>
			<p class="prose mt-1 text-sm">
				You can play right now without an account. Signing up gets you the rest of it.
			</p>
			<ul class="home-cta-list">
				<li>
					@iconTrophy("h-3.5 w-3.5")
					<span><strong>A rating</strong> that moves with every rated game you play</span>
				</li>
				<li>
					@iconChart("h-3.5 w-3.5")
					<span><strong>A profile</strong> with your record, your openings and your history</span>
				</li>
				<li>
					@iconUsers("h-3.5 w-3.5")
					<span><strong>A name</strong> other players can see, find and challenge</span>
				</li>
			</ul>
			<button type="button" id="homeCtaCreate" data-open-register class="btn btn-primary mt-3 w-full justify-center py-2">Create a free account</button>
		</div>
	}
}

// colorDot is the white/black/random piece-color indicator on a challenge and
// the pre-game summary. The random case is a hard half-white/half-black split
// (not a gradient), so it reads unmistakably as "either color" while keeping a
// player from preemptively learning their side.
templ colorDot(color string) {
	switch color {
		case "w":
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-white" title="White" aria-label="plays White"></span>
		case "b":
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-stone-900" title="Black" aria-label="plays Black"></span>
		default:
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-[linear-gradient(90deg,#ffffff_0_50%,#1c1917_50%_100%)]" title="Random" aria-label="random color"></span>
	}
}

// octadAbout is the "What is Octad?" explainer in the home page's right column:
// the copy, then a self-playing demo board (lio-home-demo.js animates random
// games fetched from /home/demo), then the learn-more buttons. The column is too
// narrow for a side-by-side copy/board split, so it stacks. The board mount
// (#home-demo-board) reuses the octadground gcon/gwrap/og-wrap structure so all
// board/piece theme CSS applies unchanged, and the overlay (#home-demo-overlay)
// reuses the in-game .end-annotation result pill.
//
// A signed-in player can put it away for good: the × writes the home.about
// preference (the prefs package) and the card is then gone server-side, so a
// member who hid it is never sent the markup or the demo board — the explainer
// stops costing them a fetch, not just screen. Anonymous visitors always see it,
// because it is the one thing on the page that says what this site is.
//
// Bringing it back lives in the header's preferences popover (prefsPopover),
// which is where the rest of this viewer's display choices already are.
templ octadAbout() {
	if viewer(ctx).Prefs.ShowHomeAbout() {
		<div id="homeAbout" class="card home-about">
			if viewer(ctx).LoggedIn {
				// lio-nav.js handles this: it persists the preference and takes
				// the card out, from the same delegated listener that drives
				// the popover's switch
				<button
					type="button"
					class="home-cta-x"
					data-pref-off={ prefs.KeyHomeAbout }
					aria-label="Hide this card"
					title="Hide — bring it back from preferences"
				>
					@iconClose()
				</button>
			}
			<h2 class="font-display text-lg font-bold text-fg">What is Octad?</h2>
			<p class="prose mt-2">
				Octad is a 4×4 chess variant: every game starts with a knight, king and two pawns per side.
				All the chess you know (check, checkmate, promotion, en passant) but with a twist: the king
				can castle with <em>any</em> of its starting pieces, and you get to pick your starting position.
			</p>
			// The tutorial is the natural next step for somebody who has just
            // read what this game is, so it leads on its own full-width row
            // rather than competing as a fourth ghost button in the reading
            // links below it.
            <a href="/learn" class="btn btn-primary mt-3 w-full no-underline text-base md:text-sm">Learn to Play →</a>
			<div class="home-demo mt-3">
				<div class="gcon">
					<div class="gwrap">
						<div id="home-demo-board" class="og-wrap"></div>
						<div id="home-demo-overlay" class="end-annotation" aria-hidden="true"></div>
					</div>
				</div>
			</div>
			<div class="btn-seg mt-2">
				<a href="/about/rules" class="btn btn-ghost no-underline text-base md:text-sm">Rules</a>
				<a href="/about/board" class="btn btn-ghost no-underline text-base md:text-sm">Board layout</a>
				<a href="/about" class="btn btn-ghost no-underline text-base md:text-sm">Learn more</a>
			</div>
		</div>
	}
}

// homeNews is the home-page news block: the three most-recent entries from the
// shared news feed, with a link out to the full paginated /news page.
templ homeNews() {
	<div class="card">
		<div class="flex items-center justify-between">
			<h2 class="font-display text-lg font-bold text-fg">News</h2>
			<a href="/news" class="text-xs font-semibold text-accent no-underline hover:underline">All news →</a>
		</div>
		<ul class="mt-2 flex flex-col divide-y divide-line">
			for _, item := range news.Latest(3) {
				@newsItem(item)
			}
		</ul>
		<p class="prose mt-3 text-sm">
			<span class="text-accent">octad</span>.gg is free and <a href="https://github.com/dechristopher/lio">open source</a>.
		</p>
	</div>
}

// newsItem renders one feed entry; shared by the home-page block and the /news
// page list.
templ newsItem(item news.Item) {
	<li class="py-2.5 first:pt-0 last:pb-0">
		<div class="flex items-baseline justify-between gap-2">
			<span class="text-sm font-semibold text-fg">{ item.Title }</span>
			<span class="shrink-0 text-[11px] uppercase tracking-wide text-fg-subtle">{ item.Date }</span>
		</div>
		<p class="mt-0.5 text-sm text-fg-muted">{ item.Body }</p>
	</li>
}
