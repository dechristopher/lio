package view

import (
	"strconv"

	"github.com/dechristopher/lio/message"
	"github.com/dechristopher/lio/news"
)

// HomeActivity is the live, self-refreshing region of the home page: the site
// stat counters and the joinable open challenges. It polls itself every 5s via
// htmx (outerHTML self-replacement), so the same component backs both the
// initial render and the /home/activity fragment. The live-games grid is NOT
// here — it streams over the /socket/tv WebSocket (see tvWidget / lio-tv.js) and
// must stay outside this htmx-swapped region so its boards are not destroyed
// every 5s.
templ HomeActivity(challenges []message.OpenChallenge, stats message.SiteStats, community message.Community) {
	<section
		id="home-activity"
		hx-get="/home/activity"
		hx-trigger="every 5s"
		hx-swap="outerHTML"
		hx-target="this"
		class="flex flex-col gap-4"
	>
		@siteStats(stats)
		@openChallenges(challenges)
		@playersCard(community)
	</section>
}

// siteStats renders the three live counters as a compact stat strip.
templ siteStats(stats message.SiteStats) {
	<div class="grid grid-cols-3 gap-2.5">
		@statTile(stats.Playing, "Online")
		@statTile(stats.LiveGames, "Live")
		@statTile(stats.TotalGames, "Games")
	</div>
}

templ statTile(n int, label string) {
	<div class="card flex flex-col items-center gap-0.5 py-3">
		<span class="font-display text-2xl font-bold leading-none text-accent">{ strconv.Itoa(n) }</span>
		<span class="text-[11px] font-semibold uppercase tracking-wider text-fg-subtle">{ label }</span>
	</div>
}

// openChallenges lists human-vs-human rooms waiting for an opponent. Each links
// to the room page, where the visitor is offered the open seat.
templ openChallenges(challenges []message.OpenChallenge) {
	<div class="card">
		<div class="flex items-center justify-between">
			<p class="font-display text-lg font-bold text-fg">Open challenges</p>
			<button type="button" data-open-create-game data-prefill-public class="text-xs font-semibold text-accent hover:underline cursor-pointer">+ New</button>
		</div>
		if len(challenges) == 0 {
			<p class="mt-3 text-sm text-fg-subtle">No open challenges right now — <button type="button" data-open-create-game data-prefill-public class="font-semibold text-accent hover:underline cursor-pointer">create one</button> to get a game going</p>
		} else {
			<ul class="mt-3 flex flex-col gap-2">
				for _, c := range challenges {
					<li>
						<a href={ templ.SafeURL("/" + c.RoomID) } class="flex items-center justify-between gap-3 rounded-md border border-line bg-panel px-3 py-2.5 no-underline transition duration-150 ease-snappy hover:-translate-y-px hover:border-accent hover:shadow-md">
							<span class="flex min-w-0 items-center gap-2.5">
								@colorDot(c.Color)
								<span class="flex min-w-0 flex-col leading-tight">
									<span class="flex items-center gap-1.5">
										@challengerName(c)
										if c.Rated {
											// rated seeks are members-only; anons see the tag and log in to join
											<span class="inline-flex flex-none items-center gap-0.5 rounded-full border border-accent/40 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-accent">
												@iconTrophy("h-2.5 w-2.5")
												Rated
											</span>
										}
									</span>
									<span class="text-[11px] uppercase tracking-wide text-fg-subtle">
										// SpeedGroup, not Group: every seek is a deploy variant, so Group
										// is the constant "deploy" and says nothing — the speed class is
										// what a player reads a challenge by
										{ c.Variant.Name } · { c.Variant.SpeedGroup().String() }
										if c.RaceTo > 0 {
											· race to { strconv.Itoa(c.RaceTo) }
										}
									</span>
								</span>
							</span>
							if c.Rated && !viewer(ctx).LoggedIn {
								<span class="btn btn-ghost flex-none px-3 py-1.5 text-xs">Log in</span>
							} else {
								<span class="btn btn-primary flex-none px-3 py-1.5 text-xs">Join</span>
							}
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

// challengerName is a seek's headline: who is waiting. A named account gets its
// title badge, username and (for a rated seek) rating; an anonymous creator gets
// a muted "Anonymous". Putting the person on the primary line and demoting the
// time control to the sub-line is deliberate — a challenge is an invitation from
// somebody, and the visible difference between a name and "Anonymous" is the
// most honest argument the page makes for holding an account.
templ challengerName(c message.OpenChallenge) {
	if c.CreatorName != "" {
		@playerTitle(c.CreatorTitle)
		<span class="truncate text-sm font-semibold text-fg">{ c.CreatorName }</span>
		if c.CreatorRating != "" {
			<span class="rating-chip flex-none">{ c.CreatorRating }</span>
		}
	} else {
		<span class="truncate text-sm font-semibold text-fg-muted">Anonymous</span>
	}
}

// playersCard is the home page's people panel: who is here now, and who just
// joined. It rides inside the htmx-polled #home-activity region, so the online
// roster refreshes every 5s for free — which is also why it holds no
// client-side state (a tab strip would be reset by every swap) and renders its
// sections stacked instead.
templ playersCard(c message.Community) {
	if hasPlayers(c) {
		<div class="card">
			// no header link: there is no player directory to point at yet, and a
			// heading link that goes somewhere unrelated is worse than none
			<p class="font-display text-lg font-bold text-fg">Players</p>
			// The viewer's own follows who are here, above the site-wide
			// roster (arch/FOLLOWING.md). These names are removed from
			// "Online now" rather than repeated there — the two lists are one
			// roster split by whether the viewer cares, and a name in both
			// would read as two people.
			if len(c.Following) > 0 {
				<p class="roster-label roster-label-following">Following</p>
				<ul class="chip-list">
					for _, m := range c.Following {
						@rosterChip(m)
					}
				</ul>
			}
			if len(c.Online) > 0 {
				<p class="roster-label">Online now</p>
				<ul class="chip-list">
					for _, m := range c.Online {
						@rosterChip(m)
					}
				</ul>
			}
			if note := anonNote(c, viewer(ctx).LoggedIn); note != "" {
				<p class="roster-note">{ note }</p>
			}
			if len(c.Newest) > 0 {
				<p class="roster-label">Arrivals</p>
				<ul class="chip-list">
					for _, m := range c.Newest {
						<li>
							// the chip shows the join date in its token form ("2d"); the
							// prose form rides in the tooltip, so nothing is lost to the
							// abbreviation for anyone who hovers
							<a href={ templ.SafeURL(profileURL(m.Username)) } class="roster-chip" title={ "joined " + RelativeDay(m.Joined) }>
								@playerTitle(m.Title)
								<span class="roster-chip-name">{ m.Username }</span>
								<span class="roster-chip-when">{ shortAgo(m.Joined) }</span>
							</a>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// rosterChip is one player in the players card: a split pill whose name links
// to their profile and whose sword opens a challenge. Two targets that read as
// a single object, which is what they are — a person and what you can do with
// them.
//
// Shared by the "Following" and "Online now" sections so the two cannot drift:
// a followed player and a stranger are the same kind of row, and the only
// difference between the lists is which of them the viewer chose to see first
// (arch/FOLLOWING.md).
templ rosterChip(m message.OnlineMember) {
	<li class="roster-item">
		<a href={ templ.SafeURL(profileURL(m.Username)) } class={ "roster-chip", templ.KV("is-playing", m.Playing), templ.KV("is-busy", m.Busy) }>
			<span class="roster-dot" aria-hidden="true"></span>
			@playerTitle(m.Title)
			<span class="roster-chip-name">{ m.Username }</span>
			// Only the unavailable members carry a tag, so it reads as a
			// distinction rather than noise repeated on every chip. It is text,
			// not just the amber dot, so the state never depends on color alone
			// — and it says why the sword is missing rather than leaving that
			// to be inferred.
			if m.Playing {
				<span class="roster-chip-tag">playing</span>
			} else if m.Busy {
				<span class="roster-chip-tag">waiting</span>
			}
		</a>
		// The sword is a sibling of the chip, not a child: the chip is a link to
		// their profile, and a button inside an anchor is neither valid nor
		// clickable in the way either one wants. The two are joined into one
		// pill by the CSS.
		//
		// It appears only for somebody who could actually accept right now — see
		// canChallenge — so it is absent for every member the dot has turned
		// amber. A control that is present but fails is worse than one that is
		// absent.
		if canChallenge(viewer(ctx), m.Username, m.Busy) {
			@challengeButton(m.Username, "roster-challenge")
		}
	</li>
}

// leaderboardCard is the rating board in the home page's right column. It shows
// one row per account (their best established rating), and only ratings that
// have stopped being provisional — a board topped by players who have never
// finished a game would rank noise.
//
// It sits outside the polled activity region on purpose: a leaderboard does not
// move on a 5-second timescale, and re-rendering it with the roster would buy
// nothing.
templ leaderboardCard(c message.Community) {
	if len(c.Top) > 0 {
		<div class="card">
			<div class="flex items-center justify-between">
				<h2 class="font-display text-lg font-bold text-fg">Top rated</h2>
				<span class="text-[11px] uppercase tracking-wide text-fg-subtle">Any time control</span>
			</div>
			<ol class="roster mt-3">
				for i, m := range c.Top {
					<li>
						<a href={ templ.SafeURL(profileURL(m.Username)) } class="roster-row">
							<span class="roster-rank">{ strconv.Itoa(i + 1) }</span>
							<span class="roster-name">
								@playerTitle(m.Title)
								<span class="truncate">{ m.Username }</span>
							</span>
							<span class="roster-rating">{ ratingLine(m) }</span>
						</a>
					</li>
				}
			</ol>
		</div>
	}
}

// homeWelcome is the anonymous visitor's account pitch: the home-page
// counterpart to the room page's thin roomAnonCta shim, given room to make an
// actual case (a rating, a profile, a name others can find and challenge).
// Gated to logged-out viewers where accounts exist, so it never shows to a
// member or in PG-less local dev.
//
// Dismissal persists exactly like the room shim's: the × writes localStorage
// and the head no-flash script stamps html[data-homecta="off"] before first
// paint, so a closed card never flashes back on the next load.
templ homeWelcome() {
	if !viewer(ctx).LoggedIn && viewer(ctx).AccountsEnabled {
		<div id="homeCta" class="card home-cta" role="region" aria-label="Create a free account">
			<button type="button" id="homeCtaDismiss" class="home-cta-x" aria-label="Dismiss" title="Dismiss">
				@iconClose()
			</button>
			<h2 class="font-display text-lg font-bold text-fg">Play as someone</h2>
			<p class="prose mt-1 text-sm">
				You can play right now without an account. Signing up gets you the rest of it.
			</p>
			<ul class="home-cta-list">
				<li>
					@iconTrophy("h-3.5 w-3.5")
					<span><strong>A rating</strong> that moves with every rated game you play</span>
				</li>
				<li>
					@iconChart("h-3.5 w-3.5")
					<span><strong>A profile</strong> with your record, your openings and your history</span>
				</li>
				<li>
					@iconUsers("h-3.5 w-3.5")
					<span><strong>A name</strong> other players can see, find and challenge</span>
				</li>
			</ul>
			<button type="button" id="homeCtaCreate" data-open-register class="btn btn-primary mt-3 w-full justify-center py-2">Create a free account</button>
		</div>
	}
}

// colorDot is the white/black/random piece-color indicator on a challenge and
// the pre-game summary. The random case is a hard half-white/half-black split
// (not a gradient), so it reads unmistakably as "either color" while keeping a
// player from preemptively learning their side.
templ colorDot(color string) {
	switch color {
		case "w":
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-white" title="White" aria-label="plays White"></span>
		case "b":
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-stone-900" title="Black" aria-label="plays Black"></span>
		default:
			<span class="inline-block h-3.5 w-3.5 rounded-full border border-line-strong bg-[linear-gradient(90deg,#ffffff_0_50%,#1c1917_50%_100%)]" title="Random" aria-label="random color"></span>
	}
}

// octadAbout is the "What is Octad?" explainer in the home page's right column:
// the copy, then a self-playing demo board (lio-home-demo.js animates random
// games fetched from /home/demo), then the learn-more buttons. The column is too
// narrow for a side-by-side copy/board split, so it stacks. The board mount
// (#home-demo-board) reuses the octadground gcon/gwrap/og-wrap structure so all
// board/piece theme CSS applies unchanged, and the overlay (#home-demo-overlay)
// reuses the in-game .end-annotation result pill.
templ octadAbout() {
	<div class="card">
		<h2 class="font-display text-lg font-bold text-fg">What is Octad?</h2>
		<p class="prose mt-2">
			Octad is a 4×4 chess variant: every game starts with a knight, king and two pawns per side.
			All the chess you know (check, checkmate, promotion, en passant) but with a twist: the king
			can castle with <em>any</em> of its starting pieces, and you get to pick your starting position.
		</p>
		<div class="home-demo mt-3">
			<div class="gcon">
				<div class="gwrap">
					<div id="home-demo-board" class="og-wrap"></div>
					<div id="home-demo-overlay" class="end-annotation" aria-hidden="true"></div>
				</div>
			</div>
		</div>
		<div class="btn-seg mt-3">
			<a href="/about/rules" class="btn btn-ghost no-underline text-base md:text-sm">Rules</a>
			<a href="/about/board" class="btn btn-ghost no-underline text-base md:text-sm">Board layout</a>
			<a href="/about" class="btn btn-ghost no-underline text-base md:text-sm">Learn more</a>
		</div>
	</div>
}

// homeNews is the home-page news block: the three most-recent entries from the
// shared news feed, with a link out to the full paginated /news page.
templ homeNews() {
	<div class="card">
		<div class="flex items-center justify-between">
			<h2 class="font-display text-lg font-bold text-fg">News</h2>
			<a href="/news" class="text-xs font-semibold text-accent no-underline hover:underline">All news →</a>
		</div>
		<ul class="mt-3 flex flex-col divide-y divide-line">
			for _, item := range news.Latest(2) {
				@newsItem(item)
			}
		</ul>
		<p class="prose mt-3 text-sm">
			octad.gg is free and <a href="https://github.com/dechristopher/lio">open source</a>.
		</p>
	</div>
}

// newsItem renders one feed entry; shared by the home-page block and the /news
// page list.
templ newsItem(item news.Item) {
	<li class="py-2.5 first:pt-0 last:pb-0">
		<div class="flex items-baseline justify-between gap-2">
			<span class="text-sm font-semibold text-fg">{ item.Title }</span>
			<span class="shrink-0 text-[11px] uppercase tracking-wide text-fg-subtle">{ item.Date }</span>
		</div>
		<p class="mt-0.5 text-sm text-fg-muted">{ item.Body }</p>
	</li>
}
