package view

import (
	"strconv"

	"github.com/dechristopher/lio/message"
	"github.com/dechristopher/lio/prefs"
	"github.com/dechristopher/lio/settings"
	"github.com/dechristopher/lio/title"
)

// header is the site wordmark + account/preferences/theme controls shown at the
// top of every page. A logged-in viewer sees their username, which opens the
// profile popover (account admin); a logged-out viewer sees "Log in", which
// opens the auth modal (login/register). width is the caller's complete sizing
// class list (base width + caps), so a page whose content uses a different
// width formula (the room game grid's min(96vw,…)) can align the header edges
// exactly to it.
// siteNotice renders the admin-set announcement banner above the header, on
// every page (arch/ADMIN_MODERATION.md Phase 3). Distinct from Meta.Notice,
// which is a per-request one-shot on the home page ("that room is gone"): this
// one is site state, set from /mod and shown until it is cleared. Renders
// nothing when unset, which is the overwhelmingly common case.
//
// It reads the settings snapshot directly rather than being threaded through
// every page's Meta — a banner that has to be remembered on each new page is a
// banner that will be missing from one.
templ siteNotice(width string) {
	if notice := settings.Current(); notice.NoticeText != "" {
		<div class={ "site-notice " + noticeLevelClass(notice.NoticeLevel) + " " + width } role="status">
			{ notice.NoticeText }
		</div>
	}
}

// maintenanceNotice is the standing "the site is in maintenance mode" bar,
// rendered on every page above the admin notice. Deliberately its own element
// rather than a variant of siteNotice: the admin banner is arbitrary copy that
// may be saying something else entirely (or nothing), and the fact that no new
// game can be started must not depend on someone having remembered to write it
// down. The two stack when both are active.
//
// It states the *consequence* rather than the mode name, because "maintenance
// mode" tells a player nothing about whether they can play.
templ maintenanceNotice(width string) {
	if settings.Current().Maintenance {
		<div class={ "maintenance-notice " + width } role="status">
			<span class="maintenance-badge">Maintenance</span>
			<span>New games are paused. Games already in progress are unaffected.</span>
		</div>
	}
}

templ header(width string) {
	@maintenanceNotice(width)
	@siteNotice(width)
	<header class={ "flex items-center justify-between gap-4 max-[400px]:gap-2 pt-1 pb-3 " + width }>
		<div class="flex min-w-0 flex-col items-start leading-none">
			<a href="/" class="no-underline">
				// wordmark: text-2xl (1.5rem) capped, staying full-size well into narrow
				// viewports. The control cluster is now bare text + icons (the theme
				// toggle also hides under 768px), and a logged-in username min-w-0
				// truncates rather than pushing the wordmark, so the wordmark rarely
				// needs to give ground. It only begins shrinking around ~270px, then
				// tracks the remaining space down to a 0.9rem floor (~214px). Same 17vw
				// slope as before; the -22px offset moves the knee from ~330px to ~270px.
				<span class="font-display text-[clamp(0.9rem,17vw_-_22px,1.5rem)] font-bold tracking-tight text-fg"><span class="text-accent">octad</span>.gg</span>
			</a>
			<div class="mt-1 flex min-w-0 items-center gap-2 text-[10px] font-semibold tracking-widest leading-none">
				<span class="text-warn uppercase">beta</span>
				@connIndicator()
			</div>
		</div>
		// z-50 lifts the control cluster (buttons + popovers) above the menu
		// scrim (z-40) so they stay crisp and clickable while the rest of the
		// page is dimmed/blurred behind an open popover.
		<div class="relative z-50 flex min-w-0 items-center gap-2">
			if viewer(ctx).LoggedIn {
				// The viewer's username as bare text (no button chrome) that opens
				// the profile popover. It sizes to its content — showing the full
				// username whenever the header has room — and min-w-0 + truncate let
				// it shrink to an ellipsis under space pressure on narrow phones
				// instead of pushing the icon controls off-screen. Keeps the name in
				// --text and the accent-tinted title badge, matching the rest of the app.
				<button type="button" id="profileButton" class="flex min-w-0 mr-1 ml-8 items-center gap-1.5 whitespace-nowrap text-sm hover:text-accent-hover font-semibold text-fg cursor-pointer">
					@playerTitle(viewer(ctx).Title)
					<span class="min-w-0 truncate">{ viewer(ctx).Username }</span>
				</button>
				// The bell sits left of the icon controls and right of the
				// username, so the element that truncates under space pressure on
				// a narrow phone stays next to the icons rather than between them.
				// Unread feedback used to be marked on the username itself; it is
				// counted into this badge now, and the dot on the popover's System
				// link still points a moderator at the inbox.
				@bellButton()
				// Only for a viewer who follows somebody, so a new account
				// never grows a fourth icon (arch/FOLLOWING.md Phase 5).
				if viewer(ctx).Following > 0 {
					@followingButton()
				}
			} else if viewer(ctx).AccountsEnabled {
				// Logged-out control: bare accent-colored text (no button chrome),
				// shown at every width — this is where the header collapses to on
				// small phones, replacing the old profile silhouette.
				<button type="button" id="loginButton" class="shrink-0 whitespace-nowrap text-sm font-semibold text-accent hover:text-accent-hover">Log in</button>
			} else {
				// PG-less local dev: accounts have no backing store
				<button type="button" id="loginButton" class="shrink-0 whitespace-nowrap text-sm font-semibold text-accent opacity-50" disabled title="Accounts are unavailable in this environment">Log in</button>
			}
			// The gear is the only appearance control in the header now. The
			// one-tap light/dark shortcut that sat beside it is gone; the prefs
			// popover carries the full Light/Dark/System picker at every width.
			<button type="button" id="prefsButton" aria-label="Preferences" title="Preferences" class="hdr-icon-btn shrink-0">
				@iconGear()
			</button>
			@prefsPopover()
			if viewer(ctx).LoggedIn {
				@notifyPanel()
				if viewer(ctx).Following > 0 {
					@followingPanel()
				}
				@profilePopover(viewer(ctx).Username, viewer(ctx).Title)
			}
		</div>
	</header>
	// backdrop for the header popovers: dims + blurs the rest of the page
	// while a menu is open, and dismisses it on click (lio-nav.js). Always in
	// the DOM, invisible until a popover opens.
	<div id="menuScrim" class="menu-scrim" aria-hidden="true"></div>
	// The create-game dialog is mounted here, so it exists on every page: the
	// following popover rides in this same header and its sword has to open
	// something wherever it is clicked (arch/FOLLOWING.md). Before this it lived
	// on the home and player pages only, and the popover's sword had to hide
	// itself everywhere else.
	//
	// Mounted unconditionally, including for a viewer who is already seated. It
	// is what the home page's Quick Game and "Create a custom game" buttons
	// open too, and those must keep working in a second tab while a game is in
	// progress — a dialog that is absent leaves them dead rather than refused.
	// What a seat suppresses is the *challenge* affordance: see canChallenge,
	// which now also asks whether the viewer is free to send one.
	//
	// No bot difficulty modal alongside it. Away from the home page this dialog
	// is only ever opened as a challenge, and a challenge disables the Computer
	// opponent, so the picker it would hand off to is unreachable. The home page
	// mounts that one itself, beside its Quick Game buttons.
	@createGameModal()
	if !viewer(ctx).LoggedIn && viewer(ctx).AccountsEnabled {
		@accountModal()
	}
	if viewer(ctx).LoggedIn {
		@securityModal()
		@editProfileModal(viewer(ctx).Username)
		@feedbackModal()
		// the feedback dialog is reachable from every page's header, so its
		// controller loads with the header rather than per-page. Deferred and
		// only for a logged-in viewer, who is the only one the prompt renders for.
		<script defer src={ asset("lio-feedback.js") }></script>
		// The notification client. It loads with the header, on every page, for
		// the same reason the feedback dialog does: the bell is in this header
		// everywhere, and the per-page script bundles (scriptsBase / scriptsTV /
		// scriptsAbout) each cover only a family of pages.
		//
		// It also owns the socket on any page that has no other one, so this is
		// what makes a signed-in visitor reachable while they read the about
		// page or their own profile. Deferred, so the page-level socket clients
		// (lio.js, lio-tv.js) have already claimed ownership by the time it runs.
		<script defer src={ asset("lio-notify.js") }></script>
		// The follow client, for the header's following popover. It also owns
		// the profile's list dialog, which is why a *signed-out* profile page
		// loads the same file itself — between the two, exactly one tag is
		// ever on a page (arch/FOLLOWING.md).
		if viewer(ctx).Following > 0 {
			<script defer src={ asset("lio-follow.js") }></script>
		}
	}
	@connScript()
	@updateNoticeScript()
}

// connIndicator is the unified ("omnibus") connection-health badge in the header.
// It starts hidden and is revealed by connScript once any live component (the
// room socket via lio.js, or the home TV widget via lio-tv.js) first reports its
// state. The dot color + label are driven by the JS-toggled conn-online /
// conn-reconnecting / conn-offline state classes.
templ connIndicator() {
	<span id="connIndicator" class="conn-indicator hidden" role="status" aria-live="polite" title="Connection">
		<span class="conn-dot"></span>
		<span class="conn-label"></span>
	</span>
}

// connScript defines window.lioConn — the shared connection-status sink both
// WebSocket clients call. It stays inlined in the header (unlike lio-nav.js) so it is
// present on every page regardless of which JS bundle a page loads. It is
// defensive: a no-op when the indicator element is absent.
templ connScript() {
	<script>
		(function () {
			const el = document.getElementById("connIndicator");
			const dot = el ? el.querySelector(".conn-dot") : null;
			const label = el ? el.querySelector(".conn-label") : null;
			const states = ["conn-online", "conn-reconnecting", "conn-offline"];
			window.lioConn = {
				// set(state, latencyMs?) — state ∈ {"online","reconnecting","updating","offline"}
				// ("updating" is the server-restart close: styled like
				// reconnecting but labeled so the drop reads as a deploy)
				set: function (state, latencyMs) {
					if (!el) { return; }
					el.classList.remove("hidden");
					states.forEach((c) => el.classList.remove(c));
					let text;
					if (state === "online") {
						el.classList.add("conn-online");
						text = (typeof latencyMs === "number") ? Math.round(latencyMs) + "ms" : "connected";
					} else if (state === "offline") {
						el.classList.add("conn-offline");
						text = "offline";
					} else if (state === "updating") {
						el.classList.add("conn-reconnecting");
						text = "updating…";
					} else {
						el.classList.add("conn-reconnecting");
						text = "reconnecting…";
					}
					if (label) { label.textContent = text; }
					el.title = "Connection: " + (state === "online" ? "connected" : state);
				}
			};
		})();
	</script>
}

// updateNoticeScript defines window.lioUpdateNotice — the shared "site
// updated, refresh" prompt. Every socket client (the room/waiting sockets in
// lio.js, the home-page TV socket in lio-tv.js) feeds it the version carried
// by the server's one-shot "si" hello; it compares that against the version
// this page was rendered by (the lio-version meta tag) and surfaces a passive
// refresh prompt on mismatch. Inlined in the header (like connScript) so it is
// present on every page regardless of which JS bundle the page loads. Passive
// on purpose: a mid-game refresh is safe (full state resync on connect) but
// forcing one mid-think would be hostile.
templ updateNoticeScript() {
	<script>
		(function () {
			window.lioUpdateNotice = function (version) {
				const rendered = document.querySelector('meta[name="lio-version"]');
				if (!rendered || !version || version === rendered.content) {
					return;
				}
				if (document.getElementById("updateNotice")) {
					return;
				}
				console.log("Server updated: " + rendered.content + " -> " + version);
				const notice = document.createElement("div");
				notice.id = "updateNotice";
				notice.setAttribute("role", "status");
				notice.className = "fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 items-center gap-3 rounded-lg border border-line-strong bg-elevated px-4 py-2.5 shadow-lg";
				notice.innerHTML =
					'<span class="text-sm font-medium text-fg"><span class="text-accent">octad</span>.gg has been updated.</span>' +
					'<button type="button" class="rounded-md border border-accent px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-accent hover:bg-accent/10" onclick="window.location.reload()">Refresh</button>' +
					'<button type="button" class="text-xs text-fg-muted hover:text-fg" aria-label="Dismiss" onclick="this.parentElement.remove()">✕</button>';
				document.body.appendChild(notice);
			};
		})();
	</script>
}

// prefsPopover is the preferences dropdown anchored under the gear button. The
// theme control is wired to the no-flash theme helpers; the rest are stubbed
// placeholders for settings that land alongside accounts.
templ prefsPopover() {
	// The menu is taller than a short viewport (a laptop in a small window, a
	// phone in landscape) once every section is in it, so it scrolls inside
	// itself rather than running off the bottom with its last rows unreachable.
	// dvh, not vh: on mobile the browser chrome collapses as the page scrolls,
	// and vh would size to the *expanded* viewport and hide the bottom row
	// behind it.
	<div id="prefsPopover" class="absolute right-0 top-[calc(100%+0.5rem)] z-50 hidden max-h-[calc(100dvh-5.5rem)] w-72 max-w-[calc(100vw-1.5rem)] overflow-y-auto overscroll-contain max-[400px]:w-[calc(100vw-1.5rem)] rounded-lg border-2 border-line-strong bg-elevated p-3 text-left shadow-lg ring-1 ring-black/5">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Preferences</p>
		<div class="mt-2">
			<p class="mb-1.5 text-xs font-medium text-fg-muted">Theme</p>
			// icon over label, like the piece-set cards below it
			<div class="grid grid-cols-3 gap-1.5">
				<button type="button" data-set-theme="light" class="mode-btn">
					@iconSun()
					<span>Light</span>
				</button>
				<button type="button" data-set-theme="dark" class="mode-btn">
					@iconMoon()
					<span>Dark</span>
				</button>
				<button type="button" data-set-theme="system" class="mode-btn">
					@iconMonitor()
					<span>System</span>
				</button>
			</div>
		</div>
		<div class="mt-3 border-t border-line pt-3">
			<p class="mb-1.5 text-xs font-medium text-fg-muted">Board</p>
			<div class="grid grid-cols-4 gap-1.5">
				@boardSwatch("green", "Green", "#FFFFDF", "#93AF6C")
				@boardSwatch("blue", "Blue", "#dee3e6", "#8ca2ad")
				@boardSwatch("purple", "Purple", "#e9e0f0", "#8f7fb5")
				@boardSwatch("pink", "Pink", "#f5dbe5", "#c27b9e")
				@boardSwatch("red", "Red", "#f4dcd6", "#c25b52")
				@boardSwatch("brown", "Brown", "#f0d9b5", "#b58863")
				@boardSwatch("yellow", "Yellow", "#fbf1c7", "#d6b84b")
				@boardSwatch("mono", "Black & White", "#e8e8e8", "#7d7d7d")
			</div>
			<p class="mb-1.5 mt-3 text-xs font-medium text-fg-muted">Pieces</p>
			<div class="grid grid-cols-3 gap-1.5">
				@pieceOption("alpha", "Alpha")
				@pieceOption("cburnett", "Cburnett")
				@pieceOption("merida", "Merida")
			</div>
		</div>
		if viewer(ctx).LoggedIn {
			// Account-backed preferences, below the three that are not: theme,
			// board and pieces live in localStorage because they must resolve
			// before first paint, while these are stored against the account and
			// follow the player between devices (the prefs package). Shown only
			// to a signed-in viewer — there is nowhere to keep the answer
			// otherwise, and a switch that forgets is worse than no switch.
			<div class="mt-3 border-t border-line pt-3">
				<p class="mb-1.5 text-xs font-medium text-fg-muted">Home page</p>
				@prefSwitch(prefs.KeyHomeAbout, "What is Octad?",
					"The explainer card and its demo board",
					viewer(ctx).Prefs.ShowHomeAbout())
			</div>
		}
		<div class="mt-3 flex flex-col gap-2 border-t border-line pt-3 opacity-60">
			@prefStub("Sounds")
		</div>
	</div>
}

// prefSwitch is one account-backed preference in the popover: a label, a hint
// and a switch. It reuses the create-game dialog's switch chrome (.cg-switch) at
// a size that fits the popover, so the site has one thing a toggle looks like.
//
// The checkbox is the state — no separate active class to keep in step — and
// lio-nav.js persists the change from the popover's delegated listener. It is
// left checked optimistically on click and put back only if the write fails: a
// display preference that flickers while a round trip resolves reads as a
// control that did not take.
templ prefSwitch(key, label, hint string, on bool) {
	<label class="pref-toggle">
		<input
			type="checkbox"
			class="cg-toggle-box"
			data-pref={ key }
			checked?={ on }
		/>
		<span class="cg-toggle-text">
			<span class="pref-toggle-title">{ label }</span>
			<span class="cg-toggle-hint">{ hint }</span>
		</span>
		<span class="cg-switch"></span>
	</label>
}

// boardSwatch is one board-theme choice in the preferences popover: a 2x2 checker
// preview (built from the theme's two square colors) that, when clicked, calls
// __setBoard via the delegated handler in lio-nav.js. The active swatch is
// ringed by lio-nav.js on open.
templ boardSwatch(name, label, light, dark string) {
	<button type="button" data-set-board={ name } title={ label } aria-label={ label } class="swatch-btn">
		<span class="swatch" style={ "--l:" + light + ";--d:" + dark }></span>
	</button>
}

// pieceOption is one piece-set choice: a preview of that set's king and pawn
// (real SVGs served from /res/img/<set>/, so each card shows its own art
// regardless of the page's active data-piece) over the label. Clicking it calls
// __setPiece via the delegated handler in lio-nav.js.
templ pieceOption(name, label string) {
	<button type="button" data-set-piece={ name } title={ label } class="piece-btn">
		<span class="piece-preview">
			<img src={ "/res/img/" + name + "/wK.svg" } alt="" width="32" height="32"/>
			<img src={ "/res/img/" + name + "/wP.svg" } alt="" width="32" height="32"/>
		</span>
		<span class="piece-label">{ label }</span>
	</button>
}

templ prefStub(label string) {
	<div class="flex items-center justify-between">
		<span class="text-xs font-medium text-fg">{ label }</span>
		<span class="rounded-full border-2 border-line px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-warn">soon</span>
	</div>
}

// accountModal is the login/register dialog shown when Log in is clicked,
// reusing the shared .modal-shade/.modal styling. The two forms swap via the
// tab buttons (lio-auth.js); submission is fetch-driven against /api/auth.
//
// When registration is closed from /system the signup form stays rendered and
// goes inert — a wrapping fieldset plus a notice saying why — rather than being
// removed: the modal must not change shape, the Sign up tab must not lead
// somewhere empty, and a visitor is owed a reason. The API refuses
// independently; this is the explanation, never the enforcement. Logging in is
// untouched, because closing signups is not a lockout.
templ accountModal() {
	<div id="modalAccount" class="modal-shade">
		<div class="modal card">
			<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
			<h2>Welcome</h2>
			<div id="authTabs" class="mt-3 grid grid-cols-2 gap-1" role="tablist" aria-label="Log in or sign up">
				<button type="button" class="theme-btn is-active" data-auth-tab="login" role="tab">Log in</button>
				<button type="button" class="theme-btn" data-auth-tab="register" role="tab">Sign up</button>
			</div>
			<form id="loginForm" class="mt-4 flex flex-col gap-3 text-left" data-auth-form="login" novalidate>
				<label class="auth-label">
					Username
					<input class="auth-input" name="username" type="text" autocomplete="username" required minlength="3" maxlength="20"/>
				</label>
				<label class="auth-label">
					Password
					<input class="auth-input" name="password" type="password" autocomplete="current-password" required/>
				</label>
				<p class="auth-error hidden" data-auth-error role="alert"></p>
				<button type="submit" class="btn btn-primary w-full justify-center py-2">Log in</button>
			</form>
			<form id="registerForm" class="mt-4 hidden flex-col gap-3 text-left" data-auth-form="register" novalidate>
				if !settings.Current().RegistrationOpen {
					<p class="auth-closed" role="status">
						New account sign-ups are temporarily closed. Existing accounts can still log in.
					</p>
				}
				<fieldset class="contents" disabled?={ !settings.Current().RegistrationOpen }>
					<label class="auth-label">
						Username
						<input class="auth-input" name="username" type="text" autocomplete="username" required minlength="3" maxlength="20" pattern="[A-Za-z0-9][A-Za-z0-9_\-]{2,19}"/>
						<span class="auth-hint" data-auth-avail></span>
					</label>
					<label class="auth-label">
						Password
						<input class="auth-input" name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="128"/>
					</label>
					<label class="auth-label">
						Email <span class="text-fg-subtle">(optional)</span>
						<input class="auth-input" name="email" type="email" autocomplete="email"/>
					</label>
					<p class="auth-hint">
						Email is only used to recover your account. Skipping it means a
						forgotten password can't be reset.
					</p>
					<p class="auth-error hidden" data-auth-error role="alert"></p>
					<button type="submit" class="btn btn-primary w-full justify-center py-2">Create account</button>
				</fieldset>
			</form>
			// second-factor step: shown by lio-auth.js when login returns
			// mfa:true. The tabs + login/register forms are hidden while it is
			// up. The single code field serves TOTP or recovery-code entry
			// depending on the chosen method; the alt buttons switch methods
			// and trigger passkey verification.
			<div id="mfaStep" class="mt-4 hidden flex-col gap-3 text-left" data-auth-form="mfa">
				<p class="auth-hint" data-mfa-prompt>Enter the 6-digit code from your authenticator app.</p>
				<form id="mfaCodeForm" class="flex flex-col gap-3" novalidate>
					<label class="auth-label">
						<span data-mfa-label>Authentication code</span>
						<input class="auth-input" name="code" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" required/>
					</label>
					<button type="submit" class="btn btn-primary w-full justify-center py-2">Verify</button>
				</form>
				<button type="button" id="mfaPasskeyBtn" class="btn btn-primary w-full justify-center py-2 hidden">Verify with a passkey</button>
				<p class="auth-error hidden" data-auth-error role="alert"></p>
				<div class="flex flex-col items-center gap-1 pt-1">
					<button type="button" class="auth-alt hidden" data-mfa-alt="passkey">Use a passkey instead</button>
					<button type="button" class="auth-alt hidden" data-mfa-alt="recovery">Use a recovery code</button>
					<button type="button" class="auth-alt hidden" data-mfa-alt="totp">Use your authenticator app</button>
				</div>
			</div>
		</div>
	</div>
}

// iconMoon / iconSun / iconMonitor label the Light/Dark/System choices in the
// preferences popover. They are drawn unconditionally — each names one mode
// rather than reporting the current one, so none of them hides per theme.
templ iconMoon() {
	<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
}

templ iconSun() {
	<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
}

// iconMonitor is the desktop display that stands for "follow the OS setting".
// Same outline motif as iconCpu / iconGear beside it.
templ iconMonitor() {
	<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
		<path d="M8 21h8M12 17v4"></path>
	</svg>
}

// iconGear backs the header preferences button.
templ iconGear() {
	<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="3"></circle>
		<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
	</svg>
}

// iconUsers / iconCpu are the site-consistent outline icons for human vs
// computer play, replacing the old emoji glyphs. They back the home-page Quick
// Game buttons (large) and the live-games badges (small); the caller passes the
// sizing class.
templ iconUsers(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
		<circle cx="9" cy="7" r="4"></circle>
		<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
		<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
	</svg>
}

templ iconCpu(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
		<rect x="9" y="9" width="6" height="6"></rect>
		<path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"></path>
	</svg>
}

// iconCopy / iconCheck back the invite-link copy button; .copy-btn.copied (set
// by lio-room-create.js) swaps copy → check via CSS.
templ iconCopy() {
	<svg class="icon-copy h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
		<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
	</svg>
}

templ iconCheck() {
	<svg class="icon-check h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20 6 9 17l-5-5"></path>
	</svg>
}

// iconQR is the lucide "qr-code" glyph backing the pre-game invite row's QR
// button, which opens the QR modal on phones (the code itself is inline on
// desktop, so the button is hidden there).
templ iconQR() {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect width="5" height="5" x="3" y="3" rx="1"></rect>
		<rect width="5" height="5" x="16" y="3" rx="1"></rect>
		<rect width="5" height="5" x="3" y="16" rx="1"></rect>
		<path d="M21 16h-3a2 2 0 0 0-2 2v3"></path>
		<path d="M21 21v.01"></path>
		<path d="M12 7v3a2 2 0 0 1-2 2H7"></path>
		<path d="M3 12h.01"></path>
		<path d="M12 3h.01"></path>
		<path d="M12 16v.01"></path>
		<path d="M16 12h1"></path>
		<path d="M21 12v.01"></path>
		<path d="M12 21v-1"></path>
	</svg>
}

// iconShare is the lucide "share" glyph backing the pre-game share button, which
// lio-room-create.js unhides only where navigator.share exists (phones) to open
// the OS share sheet with the invite link.
templ iconShare() {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
		<path d="M16 6l-4-4-4 4"></path>
		<path d="M12 2v13"></path>
	</svg>
}

// iconClose is the lucide "x" glyph backing the shared .modal-close button; an
// SVG centers cleanly in the flex button, unlike the "×" text glyph which sits
// on the font's math axis and renders optically off-center.
templ iconClose() {
	<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M18 6 6 18M6 6l12 12"></path>
	</svg>
}

// iconTrophy / iconLock back the create-modal rated status badge (cg-rated):
// the trophy lights the badge when a game would be rated, the lock marks the
// anonymous "log in to play rated" variant.
templ iconTrophy(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
		<path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
		<path d="M4 22h16"></path>
		<path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
		<path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
		<path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
	</svg>
}

templ iconLock(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
		<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
	</svg>
}

// iconChart is the lucide "bar-chart-2" glyph, standing for a player's profile
// and stats page on the home page's account pitch.
templ iconChart(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M18 20V10"></path>
		<path d="M12 20V4"></path>
		<path d="M6 20v-6"></path>
	</svg>
}

// iconPencil is the lucide "pencil" glyph backing the profile popover's Edit
// Profile button.
templ iconPencil() {
	<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 20h9"></path>
		<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
	</svg>
}

// footerContent is the footer's inner nav + copyright, shared between the
// standalone page footer and the home page's column-nested footer.
templ footerContent(meta Meta) {
	<nav data-footer-nav class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 font-medium">
		<a class="text-fg-muted no-underline transition-colors duration-150 hover:text-accent" href="/about">About</a>
		<span aria-hidden="true">·</span>
		<a class="text-fg-muted no-underline transition-colors duration-150 hover:text-accent" href="/news">News</a>
		<span aria-hidden="true">·</span>
		<a class="text-fg-muted no-underline transition-colors duration-150 hover:text-accent" href="/db">DB</a>
		<span aria-hidden="true">·</span>
		<a class="text-fg-muted no-underline transition-colors duration-150 hover:text-accent" href="https://status.octad.gg" target="_blank" rel="noopener">Status</a>
		<span aria-hidden="true">·</span>
		<a class="text-fg-muted no-underline transition-colors duration-150 hover:text-accent" href="https://github.com/dechristopher/lio">{ meta.Version }</a>
	</nav>
	// No /70 opacity modifier on either token: the light-mode --warn and --accent
	// are tuned to sit right at the readable threshold, so knocking 30% off them
	// dropped these two lines to ~3.0:1. They are already de-emphasized by size.
	<p class="m-0 text-xs text-warn"><a href="https://fbfiber.net">Proudly hosted by Fitchburg Fiber</a></p>
	<p class="m-0">© 2021-2026 <span class="text-accent">octad</span>.gg</p>
}

// footer is the shared, full-width page footer with nav links and the build
// version. width carries the page's responsive max-width (and may add display
// utilities, e.g. md:hidden for the home page's mobile-only footer).
templ footer(meta Meta, width string) {
	<footer class={ "flex w-[92vw] flex-col items-center gap-1.5 pb-6 text-xs text-fg-subtle " + width }>
		@footerContent(meta)
	</footer>
}

// homeFooter is the home page's desktop footer: it nests at the bottom of the
// left column in the two-column grid (hidden on mobile, where the standalone
// footer handles the single-column bottom).
templ homeFooter(meta Meta) {
	<footer class="hidden flex-col items-center gap-1.5 pb-2 text-sm text-fg-subtle md:flex">
		@footerContent(meta)
	</footer>
}

// quickGameButtons renders the quick vs-human / vs-computer buttons. The icons
// are flat/outline SVGs (matching the header controls) tinted with the accent.
// Each is a POST form (not a GET link): creating a room is a state change, so a
// GET would be CSRF-able. The form is display:contents so its submit button is
// the grid item directly, preserving the two-column layout.
templ quickGameButtons() {
	<div class="mt-2 grid grid-cols-2 gap-2.5">
		<form action="/new/human/quick" method="POST" class="contents">
			<button type="submit" aria-label="Quick game versus human" title="Quick game vs human" class="btn btn-ghost flex-col gap-1.5 py-3">
				<span class="text-accent">
					@iconUsers("h-7 w-7")
				</span>
				<span class="text-sm font-semibold text-fg">vs Human</span>
			</button>
		</form>
		<form action="/new/computer" method="POST" class="contents" data-bot-difficulty="quick">
			<button type="submit" aria-label="Quick game versus the computer" title="Quick game vs the computer" class="btn btn-ghost flex-col gap-1.5 py-3">
				<span class="text-accent">
					@iconCpu("h-7 w-7")
				</span>
				<span class="text-sm font-semibold text-fg">vs Computer</span>
			</button>
		</form>
	</div>
}

// createGameButton renders the button that opens the custom-game modal. The id
// is wired to the modal open/close script in createGameModal.
templ createGameButton() {
	<button type="button" id="createGameButton" data-open-create-game title="Create a custom game" class="btn btn-primary btn-block mt-3 text-xl font-bold">Custom game</button>
}

// board renders the octadground board mount and its promotion / result-overlay
// scaffolding. The payload's PlayerColor becomes the board-orientation class
// ("w"/"b"); spectators are oriented to the anchored player's current color and
// carry a data-spectator attribute that lio-game.js reads once at init to enter
// watch-only mode, plus data-anchor (the anchored player's id) so the client
// can keep that player on the bottom as colors swap between games. data-deploy
// marks blind-deploy variants: the client boots those boards empty so the
// default arrangement never flashes before the socket delivers the real
// (possibly still hidden) position.
// botRematchURL, when set (bot games only), is the "same settings" fresh-room
// rematch link the result overlay's Rematch button navigates to.
templ board(payload message.RoomTemplatePayload) {
	<div class="board-shell">
		// engine evaluation bar: revealed by lio-game.js only after a *bot*
		// game ends and the player enters analysis (requestLiveEvals fetches
		// the finished game's cached evals). Human-vs-human rooms never show
		// it — their games get the bar on the archive page instead.
		<div id="eval-bar" class="eval-bar" hidden title="Engine evaluation">
			<div class="eval-fill"></div>
		</div>
		<div id="gcon-xx" class={ "gcon " + boardOrientation(payload) } data-spectator={ strconv.FormatBool(payload.IsSpectator) } data-anchor={ payload.AnchorID } data-tc={ strconv.FormatInt(payload.Variant.Control.Time.Centi(), 10) } data-casual={ strconv.FormatBool(payload.Variant.Casual) } data-deploy={ strconv.FormatBool(payload.Variant.Deploy) }>
			<div class="gwrap">
				<div id="game" class="og-wrap"></div>
				// blind deploy: opponent home-rank "?" cells, overlaid on the top rank
				<div id="deploy-questions" class="deploy-questions" aria-hidden="true">
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
				</div>
				// blind deploy (spectator): bottom home-rank "?" cells, hiding both sides
				<div id="deploy-questions-btm" class="deploy-questions deploy-questions-btm" aria-hidden="true">
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
				</div>
				// blind deploy: on-board controls (non-blocking so the board stays interactive)
				<div id="deploy-overlay" class="deploy-overlay">
					<div class="deploy-card">
						<div class="deploy-headline">Arrange your pieces</div>
						<div class="deploy-hint">Drag a piece onto another — or tap two squares — to swap, then confirm.</div>
						<div id="deploy-countdown" class="deploy-countdown"></div>
						<button id="deploy-confirm" type="button" class="deploy-btn">Confirm deployment</button>
						<div id="deploy-waiting" class="deploy-waiting hidden">Locked in — waiting for opponent…</div>
						<div id="deploy-opponent-status" class="deploy-opp-status hidden"></div>
					</div>
				</div>
				// pre-start countdown: small radial timer shown mid-board after the
				// deploy reveal until white moves or the countdown expires and their
				// clock starts on its own (lio-game.js toggles .ps-show and drives
				// the ring's stroke-dashoffset). Non-blocking: white can move under it.
				<div id="prestart-overlay" class="prestart-overlay" aria-hidden="true">
					<div class="prestart-dial">
						<svg class="prestart-ring" viewBox="0 0 48 48">
							<circle class="prestart-track" cx="24" cy="24" r="21"></circle>
							<circle id="prestart-progress" class="prestart-progress" cx="24" cy="24" r="21"></circle>
						</svg>
						<div id="prestart-number" class="prestart-number"></div>
					</div>
				</div>
				// spectator audio-unlock: browsers keep audio muted until a page
				// gesture, and a spectator may never otherwise interact. lio-game.js
				// shows this tappable mid-board icon while audio is locked so the
				// silent state has a visible fix; any tap on the page unlocks too —
				// this is just the affordance (hidden again the moment audio runs).
				<div id="audio-unlock-overlay" class="audio-unlock-overlay" aria-hidden="true">
					<button id="audio-unlock" type="button" class="audio-unlock" title="Tap to enable sound" aria-label="Enable sound">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z"></path>
						</svg>
					</button>
				</div>
				// endgame annotation: a small non-interactive pill naming the finished
				// game's result, shown mid-board while the final position is reviewed
				// with the result card out of the way (lio-game.js toggles .ea-show)
				<div id="end-annotation" class="end-annotation" aria-hidden="true"></div>
				<div id="promo-shade" class="promo-shade hidden"></div>
				<div id="promo-select" class="promo hidden">
					<piece class="promo queen"></piece>
					<piece class="promo rook"></piece>
					<piece class="promo bishop"></piece>
					<piece class="promo knight"></piece>
				</div>
				<div id="result-overlay" class="result-overlay">
					<div class="result-card">
						<div id="result-headline" class="result-headline"></div>
						<div id="result-reason" class="result-reason"></div>
						// race-to match context, filled and revealed by lio-game.js
						// only for a match room: the points target, plus a
						// match-point note when the next game can decide it. It
						// leads the score below it — the number means little until
						// you know what it is racing to — and is separated from it
						// by the rule beneath. Classic rooms never show it.
						<div id="result-match" class="result-match hidden">
							<div id="result-match-target" class="result-match-target"></div>
							<div id="result-match-note" class="result-match-note hidden"></div>
						</div>
						<div id="result-score" class="result-score"></div>
						// per-player rating change (rated games only): filled by
						// lio-game.js from the rating-update frame, empty (and
						// collapsed) otherwise
						<div id="result-ratings" class="result-ratings"></div>
						<div id="result-note" class="result-note hidden"></div>
						<div class="result-actions">
							// mid-match only: skip the rest of the interlude. Both
							// seats must ask; one seat asking just shows the other
							// a check while the pause runs out normally. Shown in
							// place of Rematch, which has no meaning mid-match.
							<button id="result-next" type="button" class="result-btn result-next hidden" title={ controlTitle(payload, "Start the next game now") } disabled?={ payload.IsSpectator }>Next game</button>
							<button id="result-rematch" type="button" class="result-btn result-rematch" title={ controlTitle(payload, "Play again") } data-rematch-url={ botRematchURL(payload) } disabled?={ payload.IsSpectator }>Rematch</button>
							<button id="result-home" type="button" class="result-btn result-home">Home</button>
						</div>
						// who has asked for the next game: this seat's check lands
						// on click, the opponent's when their request arrives. Sits
						// under the actions because it reports on the button above
						// it — both checks mean the next game starts now.
						<div id="result-ready" class="result-ready hidden">
							<span id="ready-you" class="ready-chip">
								<span class="ready-mark" aria-hidden="true">✓</span>
								<span class="ready-label">You</span>
							</span>
							<span id="ready-opp" class="ready-chip">
								<span class="ready-mark" aria-hidden="true">✓</span>
								<span class="ready-label">Opponent</span>
							</span>
						</div>
						<button id="result-analyze" type="button" class="result-analyze">Analyze board</button>
						// Reporting the opponent, offered only where it can mean
						// something: a logged-in viewer who played this game against
						// another account. A bot, an anonymous opponent, a spectator
						// or a logged-out viewer all render nothing rather than a
						// control that would be refused. Understated on purpose —
						// it sits below the result, not beside Rematch, because
						// most games end without anyone needing it.
						if opp := reportableOpponent(payload); opp != "" && viewer(ctx).LoggedIn {
							<button id="result-report" type="button" class="result-report" data-report-target={ opp }>Report { opp }</button>
						}
						<div id="result-countdown" class="result-countdown"></div>
					</div>
					// shown once the result card is dismissed for board review; restores it
					<button id="result-restore" type="button" class="result-restore hidden" title="Show result">Result ▲</button>
				</div>
			</div>
		</div>
	</div>
}

// clock renders a single clock widget. The wrapping element in roomGame carries
// the #clockPlayer/#clockOpponent id and the JS-toggled .active/.low/.playerWhite
// state classes; lio-game.js reads the .clockScore/.clockTime/.clockProgressBar/
// .clockMaterial/.thinking hooks inside. name is the static label ("You" /
// "Queen" / "Opponent"); botGlyph is a bot seat's difficulty-persona piece glyph
// (rendered as the seat avatar in the .clockBot slot, in place of the generic
// CPU icon), or "" for a human seat.
//
// Layout is vertically stacked: an identity row (bot glyph, name, rating,
// thinking dots on the left; match-score chip pushed to the right) sits above
// the big time on its own full-width line. Stacking decouples the time from the
// name so a long name only ellipsizes within its row and never compresses the
// clock horizontally.
// timelineName renders a match-timeline seat's title and name, linking to the
// player's page when the seat is a real account. Its own component because the
// timeline appears in both the live room and the archive, and the two must not
// drift into linking on different rules.
templ timelineName(t title.Title, name, href string) {
	if href == "" {
		@playerTitle(t)
		<span class="tl-name">{ name }</span>
	} else {
		<a class="player-link" href={ templ.SafeURL(href) }>
			@playerTitle(t)
			<span class="tl-name">{ name }</span>
		</a>
	}
}

// playerTitle renders a player's optional account display title as a compact
// accent-colored badge to the left of their name (lichess-style "GM"/"WFM"/…).
// The badge shows the titles row's short code and hovers its full name as the
// tooltip ("GM" → "Grandmaster"); a title whose row carries no name falls back
// to tooltipping the code. Its color follows the current board theme's
// --accent (see app.css .player-title), so it retints with the theme. Renders
// nothing for an unset title — anonymous/bot seats and untitled accounts — so
// it can be dropped in unconditionally before any name. Assigned by pointing
// users.title_id at a titles row (no in-app assignment UI).
// playerName renders an account's title and username as a link to their profile.
// One component so the convention — a username on this site is a way to reach
// that player's page — is applied the same way everywhere rather than
// re-decided per surface.
//
// username must be a real account name: "Anonymous", "BOT" and the viewer's own
// "You" are labels, not accounts, and have no page to point at. Callers that
// cannot tell the difference pass an empty href and get plain text.
templ playerName(t title.Title, username, href string) {
	if href == "" {
		@playerTitle(t)
		<span class="min-w-0 truncate">{ username }</span>
	} else {
		<a class="player-link" href={ templ.SafeURL(href) }>
			@playerTitle(t)
			<span class="min-w-0 truncate">{ username }</span>
		</a>
	}
}

templ playerTitle(t title.Title) {
	if t.Set() {
		<span class="player-title" title={ t.Tooltip() }>{ t.Code }</span>
	}
}

templ clock(seatTitle title.Title, name string, botGlyph string, rating string, ratingDelta int, profile string) {
	<div class="clock">
		<div class="clockProgress">
			<div class="clockProgressBg"></div>
			<div class="clockProgressBar"></div>
		</div>
		<div class="clock-body">
			<div class="clock-meta">
				// seat presence: green while this seat's socket is connected (crowd
				// messages toggle .presence-on on the wrapper). A bot seat hides the
				// dot and tints the CPU glyph below as its indicator instead.
				<span class="clockPresence" title="Player connection"></span>
				<span class="clockBot" aria-label="Computer player" title="Computer player">
					@iconCpu("h-3.5 w-3.5")
				</span>
				if botGlyph != "" {
					<span class="clockBotGlyph" aria-hidden="true">{ botGlyph }</span>
				}
				// a seat that is a real account links to its page; "You",
				// "Anonymous" and "BOT" are labels, not accounts, so the caller
				// passes no href for them
				if profile != "" {
					<a class="player-link" href={ templ.SafeURL(profile) }>
						@playerTitle(seatTitle)
						<span class="clockName">{ name }</span>
					</a>
				} else {
					@playerTitle(seatTitle)
					<span class="clockName">{ name }</span>
				}
				if rating != "" {
					<span class="clockRating">
						<span class="clockRatingNumber">{ rating }</span>
						if ratingDelta != 0 {
							<span class={ "clockRatingDelta " + ratingDeltaClass(ratingDelta) }>{ ratingDeltaText(ratingDelta) }</span>
						}
					</span>
				}
				// material-difference icons (lichess-style): lio-game.js fills this
				// with <piece> sprites for the piece types this seat is up, plus a
				// +N point score when this seat leads; empty (and collapsed via
				// :empty) while material is level
				<span class="clockMaterial" title="Material advantage"></span>
				<span class="thinking" aria-label="thinking"><i></i><i></i><i></i></span>
				<span class="clockScore">0</span>
			</div>
			<span class="clockTime">0:00.0</span>
		</div>
	</div>
}

// seatBotMarker renders a bot seat's identity badge for the match-timeline rows:
// the generic CPU "computer" icon plus, when set, the difficulty-persona piece
// glyph — the same pair the clock shows, in the compact timeline. Renders
// nothing for a human seat. glyph is the persona piece (BotSeatGlyph), "" if
// unknown/absent. Grouped in one .tl-seat flex box so the icon+glyph stay tight
// (a single gap to the name). Styling lives in app.css (.tl-seat*).
templ seatBotMarker(isBot bool, glyph string) {
	if isBot {
		<span class="tl-seat">
			<span class="tl-seat-bot" aria-label="Computer player" title="Computer player">
				@iconCpu("tl-seat-ico")
			</span>
			if glyph != "" {
				<span class="tl-seat-glyph" aria-hidden="true">{ glyph }</span>
			}
		</span>
	}
}

// confirmActionModal is the single confirmation step shared by every privileged
// change — the site controls on /system and the moderation bar on a player
// page. It replaces two things that sat badly together: a reason field parked
// at the top of a form (asking for a justification before you had chosen what
// to justify) and a browser confirm() carrying a generic sentence.
//
// The modal states the specific change, who or what it lands on, and its
// consequence, then asks for the reason in the same breath — which is the order
// the decision actually happens in, and means the reason is typed against a
// change the operator can still see. Naming the target matters most on a player
// page, where acting on the wrong account is the classic mistake.
//
// lio-mod.js fills the summary and owns the submit; the shell is server-rendered
// so the markup and styling live with the rest of the page.
templ confirmActionModal() {
	<div id="modalConfirmChange" class="modal-shade">
		<div class="modal card">
			<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
			<h2 id="confirmTitle">Confirm change</h2>
			<div class="mt-3 text-left">
				<div id="confirmSummary" class="confirm-summary"></div>
				<form id="confirmForm" class="mt-3 flex flex-col gap-3" novalidate>
					<label class="auth-label">
						Reason
						<input
							id="confirmReason"
							class="auth-input"
							name="reason"
							type="text"
							maxlength="500"
							autocomplete="off"
							required
							placeholder="Recorded in the audit log"
						/>
					</label>
					<p id="confirmError" class="auth-error hidden" role="alert"></p>
					<div class="flex items-stretch gap-2">
						<button type="button" id="confirmCancel" class="btn btn-ghost flex-1 justify-center py-2">Cancel</button>
						<button type="submit" id="confirmApply" class="btn btn-primary flex-1 justify-center py-2">Confirm</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
