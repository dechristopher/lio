package view

import "strconv"

// The follow control (arch/FOLLOWING.md). The counts it changes are rendered by
// the profile hero; this is the button, and it lives in its own file because
// the feature's list modal joins it here in Phase 2.

// followButton is the two-state control on a player page. It is rendered only
// for a viewer who may press it — logged in, looking at somebody else's open
// account — which the model decides (FollowView.Control).
//
// The state is carried three ways on purpose. The class drives the styling,
// aria-pressed tells a screen reader which of the two states holds, and the
// visible label says it in words. A control whose only difference is a tint
// says nothing to somebody who cannot see the tint.
//
// It carries no form and no href. Following is a fetch against /api/follow,
// because the answer belongs in the button rather than in a new page.
templ followButton(username string, following bool) {
	<button
		type="button"
		class={ "btn btn-ghost follow-btn", templ.KV("is-following", following) }
		data-follow={ username }
		aria-pressed={ strconv.FormatBool(following) }
	>
		<span class="follow-ico" aria-hidden="true">
			@iconUserPlus()
			@iconUserCheck()
		</span>
		// Both labels stay in the DOM, stacked in one grid cell, so the button
		// is as wide as the longer of the two from the first paint. Pressing it
		// must not resize it and shift the Challenge button beside it.
		<span class="follow-copy">
			<span class="follow-line" data-state="off">Follow</span>
			<span class="follow-line" data-state="on">Following</span>
		</span>
	</button>
}

// followModal is the dialog behind the two counts in the hero: who follows this
// player, and who they follow.
//
// One dialog with two tabs rather than two dialogs. The lists are the same
// shape, comparing them is a thing people do, and a reader who opened the wrong
// one should not have to close it to reach the other.
//
// The rows are **not** rendered here. The list is paged, so a Go renderer and a
// JavaScript renderer would both have to exist and would drift apart the first
// time a row grew a field — the same reason the notification panel renders in
// the client (arch/NOTIFICATIONS.md). This is the frame; lio-follow.js fills it.
//
// owner is the account whose lists these are. viewer is the account reading
// them, empty when signed out: the client needs it to know whether a row toggle
// also moves the owner's "following" figure, which happens exactly when the two
// are the same person.
templ followModal(owner, viewer string) {
	<div id="modalFollow" class="modal-shade" data-follow-owner={ owner } data-follow-viewer={ viewer }>
		<div class="modal follow-modal card">
			<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
			<div class="follow-head">
				<h2 class="follow-title">{ owner }</h2>
				<div class="follow-tabs" role="tablist" aria-label="Follow lists">
					<button type="button" class="follow-tab" role="tab" aria-selected="true" data-follow-tab="followers">Followers</button>
					<button type="button" class="follow-tab" role="tab" aria-selected="false" data-follow-tab="following">Following</button>
				</div>
			</div>
			<div class="follow-list" data-follow-list role="tabpanel">
				<p class="follow-empty">Loading…</p>
			</div>
			// Rendered always and revealed only when another page exists. A
			// paginator that is created on demand would shift the list under a
			// reader at the moment they reached the end of it.
			<button type="button" class="follow-more" data-follow-more hidden>Load more</button>
		</div>
	</div>
}

// followingButton is the header control (arch/FOLLOWING.md Phase 5): a way into
// the people this viewer follows, badged with how many of them are here now.
//
// It renders only for a viewer who follows at least one account. That is the
// answer to arch/NOTIFICATIONS.md's objection to a fourth header icon ("the
// header is already narrow... a fourth icon makes the account name shorter on a
// telephone"): a new account never grows one, following somebody is what
// creates it, and its appearing is therefore self-explanatory.
//
// The badge is painted here and **kept live by the socket**. It used to be a
// render-time number only, because keeping it live needed presence to emit
// connect/disconnect events and that machinery did not exist; the home digest's
// coalesced tick is that machinery, so the hub now pushes this count to every
// socket on the site whenever the viewer's own answer changes
// (arch/HOME_ACTIVITY_STREAMING.md, and lioFollowBadge in lio-follow.js).
//
// Rendering it here as well is still right: the socket opens a moment after the
// paint, and a badge that appeared late would read as somebody who had just
// signed on.
//
// Rendered twice per page — once in the header, once in the profile popover's
// title row — because under 500px the header has no room for it beside the
// username (app.css .hdr-relocatable / .hdr-relocated show exactly one of the
// pair). Hence the id and placement class as parameters, and data-following-btn
// on both: it is how lio-follow.js repaints every copy of the badge, and how
// lio-nav.js is spared knowing which copies a page happens to carry.
templ followingButton(id string, place string) {
	<button
		type="button"
		id={ id }
		data-following-btn
		class={ "hdr-icon-btn hdr-badged shrink-0 " + place }
		aria-label="Following"
		title="Following"
		aria-haspopup="true"
		aria-expanded="false"
	>
		@iconUsersHeader()
		if viewer(ctx).FollowingOnline > 0 {
			<span class="notify-dot is-online" role="status" aria-label={ followingOnlineLabel(viewer(ctx).FollowingOnline) }></span>
		}
	</button>
}

// followingPanel is the dropdown behind it. It follows the other header
// popovers exactly (prefsPopover, profilePopover, notifyPanel): hidden by
// default, opened by navScript, dimmed behind the shared scrim, and closed on a
// restore from the back/forward cache.
//
// Like the notification panel it renders no rows. lio-follow.js fetches
// /api/follow/mine on the first open and builds them with the same row renderer
// the profile's list dialog uses — one renderer, so the two surfaces cannot
// describe the same person differently.
templ followingPanel() {
	// data-can-challenge is the viewer's own availability, which the rows need
	// and the client cannot otherwise know: a seated viewer gets no swords, by
	// the same rule canChallenge applies on the server-rendered surfaces.
	<div
		id="followingPanel"
		class="absolute right-0 top-[calc(100%+0.5rem)] z-50 hidden w-80 max-w-[calc(100vw-1.5rem)] max-[400px]:w-[calc(100vw-1.5rem)] rounded-lg border-2 border-line-strong bg-elevated p-3 text-left shadow-lg ring-1 ring-black/5"
		data-can-challenge={ strconv.FormatBool(!viewer(ctx).Seated) }
	>
		<div class="flex items-baseline justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Following</p>
			// Straight to the whole list rather than merely to the profile that
			// holds it. The fragment is read by lio-follow.js, which opens the
			// dialog on that tab — so "All" lands on the same content the
			// popover was showing, just uncapped and paged.
			<a href={ templ.SafeURL(profileURL(viewer(ctx).Username) + "#following") } class="text-xs text-fg-subtle hover:text-fg">All</a>
		</div>
		<div id="followingList" class="follow-panel-list mt-2" data-loaded="false">
			<p class="follow-empty">Loading…</p>
		</div>
	</div>
}

// iconUsersHeader is the lucide "users" glyph at header size — the same drawing
// the home page's "vs Human" button and the follow notification carry, so the
// site draws people one way.
templ iconUsersHeader() {
	<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
		<circle cx="9" cy="7" r="4"></circle>
		<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
		<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
	</svg>
}

// iconUserPlus is the lucide "user-plus" glyph: the unfollowed state.
templ iconUserPlus() {
	<svg class="follow-glyph" data-state="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
		<circle cx="9" cy="7" r="4"></circle>
		<line x1="19" y1="8" x2="19" y2="14"></line>
		<line x1="22" y1="11" x2="16" y2="11"></line>
	</svg>
}

// iconUserCheck is the lucide "user-check" glyph: the followed state.
templ iconUserCheck() {
	<svg class="follow-glyph" data-state="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
		<circle cx="9" cy="7" r="4"></circle>
		<polyline points="16 11 18 13 22 9"></polyline>
	</svg>
}
