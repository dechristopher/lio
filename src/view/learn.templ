package view

import "github.com/dechristopher/lio/learn"

// Learn renders the hands-on tutorial: a lesson rail, the board, and the coach
// panel. It is one page for the whole course — lio-learn.js swaps lessons in
// place from the curriculum inlined as #learn-data and rewrites the URL, so
// moving between lessons costs no navigation, while every lesson stays a real
// URL that can be linked, bookmarked and reloaded (the server renders the page
// opened at whichever one was asked for).
//
// The board is the room's .gcon/.gwrap/.og-wrap structure, so every board and
// piece theme applies here unchanged, and it carries the promotion picker (the
// promotion lesson needs it) and the .end-annotation result pill (the
// graduation game ends like a real one). It deliberately does not carry the
// live game's clocks, deploy countdown, pre-start dial or result card: none of
// those have meaning without a room.
templ Learn(meta Meta, lesson *learn.Lesson) {
	@base(meta) {
		<body>
			<div class="page">
				@header("w-[min(96vw,72rem)]")
				<main class="learn w-[min(96vw,72rem)]">
					<div class="learn-head">
						<div>
							<h1 class="font-display text-2xl font-bold text-fg">Learn to play Octad</h1>
							<p class="learn-sub">
								Nine short lessons, all hands-on. You can stop and come back whenever.
							</p>
						</div>
						// overall course progress, filled by lio-learn.js from the
						// lessons this device has finished
						<div class="learn-course-progress" aria-label="Course progress">
							<div class="learn-cp-bar"><div id="learn-cp-fill" class="learn-cp-fill"></div></div>
							<span id="learn-cp-text" class="learn-cp-text"></span>
						</div>
					</div>
					<div class="learn-grid">
						@learnRail(lesson)
						<div class="learn-stage">
							@learnBoard()
						</div>
						@learnCoach(lesson)
						@learnFinished()
					</div>
				</main>
				// outside the grid: a modal is fixed-position chrome, not a cell
				@learnFinishedModal()
				@footer(meta, "max-w-[72rem]")
			</div>
			// the curriculum, inside the body and so ahead of the scripts below:
			// lio-learn.js reads it at parse time, and a payload emitted after
			// the script that consumes it simply is not there yet
			@templ.JSONScript("learn-data", buildLearnModel(lesson.Slug))
		</body>
		@scriptsLearn(meta)
	}
}

// learnRail is the course index: chapters, their lessons, and a check on each
// lesson this device has finished (lio-learn.js adds .done from localStorage).
// Every entry is a real link, so the course is navigable — and crawlable —
// with no JavaScript at all; the client intercepts the clicks to swap in place.
templ learnRail(current *learn.Lesson) {
	<nav class="learn-rail" aria-label="Lessons">
		for _, chapter := range learnChapters() {
			<div class="learn-chapter">
				<h2 class="learn-chapter-title">{ chapter.Title }</h2>
				<ul class="learn-lessons">
					for _, l := range chapter.Lessons {
						<li>
							<a
								href={ templ.SafeURL("/learn/" + l.Slug) }
								class={ "learn-lesson", templ.KV("current", l.Slug == current.Slug) }
								data-lesson={ l.Slug }
							>
								<span class="learn-lesson-icon" aria-hidden="true">{ l.Icon }</span>
								<span class="learn-lesson-text">
									<span class="learn-lesson-title">{ l.Title }</span>
									<span class="learn-lesson-blurb">{ l.Blurb }</span>
								</span>
								<span class="learn-lesson-check" aria-hidden="true">✓</span>
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</nav>
}

// learnBoard is the tutorial board mount. #learn-board takes octadground; the
// overlays around it are the ones a lesson actually needs, and each is the
// room's own markup so the room's CSS styles it unchanged.
templ learnBoard() {
	<div class="board-shell learn-board-shell">
		<div id="learn-gcon" class="gcon w">
			<div class="gwrap">
				<div id="learn-board" class="og-wrap"></div>
				// blind deploy, exactly as the live phase renders it: an opaque
				// "?" band over the opponent's home rank while both sides arrange
				// in secret, faded out on the reveal. The deploy lesson is only
				// honest if it hides what a real deploy hides.
				<div id="learn-deploy-questions" class="deploy-questions" aria-hidden="true">
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
					<span class="dq-cell">?</span>
				</div>
				// the arrange card, with its confirm where a real game puts it —
				// on the board, not in the side panel. Non-blocking, so the board
				// stays draggable underneath.
				<div id="learn-deploy-overlay" class="deploy-overlay">
					<div class="deploy-card">
						<div class="deploy-headline">Arrange your pieces</div>
						<div class="deploy-hint">Drag a piece onto another — or tap two squares — to swap. Swap as often as you like.</div>
						<button id="learn-deploy-confirm" type="button" class="deploy-btn">Confirm deployment</button>
						<div id="learn-deploy-waiting" class="deploy-waiting hidden">Locked in — waiting for opponent…</div>
					</div>
				</div>
				// the graduation game ends with the same mid-board result pill a
				// real game shows
				<div id="learn-annotation" class="end-annotation" aria-hidden="true"></div>
				// promotion picker, reused verbatim from the game board: the
				// promotion lesson is the point at which a learner first meets it
				<div id="learn-promo-shade" class="promo-shade hidden"></div>
				<div id="learn-promo" class="promo hidden">
					<piece class="promo queen"></piece>
					<piece class="promo rook"></piece>
					<piece class="promo bishop"></piece>
					<piece class="promo knight"></piece>
				</div>
			</div>
		</div>
	</div>
}

// learnCoach is the panel that talks to the learner: which step they are on,
// what to do, how it went, and the controls. Everything inside it is rewritten
// by lio-learn.js as the lesson runs; the server renders the opening lesson's
// first step so the page is complete on arrival.
templ learnCoach(lesson *learn.Lesson) {
	<aside class="learn-coach" aria-live="polite">
		<div class="learn-coach-head">
			<h2 id="learn-title" class="learn-coach-title">{ lesson.Title }</h2>
			<div id="learn-dots" class="learn-dots" aria-label="Steps in this lesson">
				for i := 0; i < learnStepCount(lesson); i++ {
					<span class={ "learn-dot", templ.KV("current", i == 0) }></span>
				}
			</div>
		</div>
		// the teaching, then the instruction. lio-learn.js rebuilds both nodes
		// per step; keep the two-node shape, because the accent on .learn-action
		// is the only thing that survives a skim of the paragraph above it.
		<p id="learn-prompt" class="learn-prompt">
			{ learnFirstPrompt(lesson) }
			<strong id="learn-action" class="learn-action">{ learnFirstAction(lesson) }</strong>
		</p>
		// the coach's reaction to the last move: success, nudge, or failure.
		// Empty and collapsed until there is something to say, and it reserves
		// no space, so nothing on the page moves when it appears — it is the
		// last thing in the panel's flow.
		<p id="learn-feedback" class="learn-feedback" role="status"></p>
		<div id="learn-actions" class="learn-actions">
			// Back walks the course in reverse: the previous step, or the
			// previous lesson's last step at a lesson boundary. Disabled rather
			// than hidden at the very start, so the row never changes shape.
			<button id="learn-back" type="button" class="btn btn-ghost" title="Previous step">← Back</button>
			// no commit button here: the deploy lesson confirms from the card on
			// the board, which is where a real game puts it
			<button id="learn-show" type="button" class="btn btn-ghost">Show me</button>
			<button id="learn-reset" type="button" class="btn btn-ghost">Reset</button>
			<button id="learn-next" type="button" class="btn btn-primary hidden">Next →</button>
		</div>
	</aside>
}

// learnFinished is the hand-off to a real game, revealed by lio-learn.js once
// every lesson is done.
//
// It is a sibling of the coach panel rather than a child of it, and that is
// load-bearing on mobile: the single-column order is coach, board, then this.
// Inside the panel it sat between the instruction and the board, so finishing
// the course pushed the board off-screen and left every replayed lesson needing
// a scroll up and down to see the prompt and the pieces at once. On desktop it
// simply takes the cell under the coach.
templ learnFinished() {
	<div id="learn-finished" class="learn-finished hidden">
		<h3 class="learn-finished-title">You have finished the course</h3>
		@learnFinishedBody()
	</div>
}

// learnFinishedBody is the hand-off itself: what finishing means, and the two
// ways out of the course. Rendered twice — in the standing card above, and in
// the completion modal below — so the two surfaces cannot come to say different
// things or offer different opponents.
templ learnFinishedBody() {
	<p class="learn-finished-text">
		That is every rule of Octad. Time to play somebody.
	</p>
	// one rung up from the tutorial's own opponent: somebody who just
	// finished the course has beaten Pawn already
	<form method="POST" action="/new/computer" class="contents">
		<input type="hidden" name="bot" value="knight"/>
		<button type="submit" class="btn btn-primary w-full">Play the computer</button>
	</form>
	<a href="/" class="btn btn-ghost mt-2 w-full no-underline">Find a human opponent</a>
}

// learnFinishedModal is the congratulation, shown once — at the moment the last
// lesson's Finish is pressed (lio-learn.js opens it; nothing opens it on load).
//
// The card above is the same hand-off standing in the page for anyone who comes
// back to an already-finished course. It is easy to miss at the moment it is
// earned, though: on a phone it is below the board, so finishing the course used
// to mean a smooth scroll to a small green box somewhere under the pieces. The
// modal is that moment, in front of the learner; the card remains what they find
// on their next visit.
templ learnFinishedModal() {
	<div id="learn-done-modal" class="modal-shade">
		<div class="modal card learn-done">
			<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
			<span class="learn-done-mark" aria-hidden="true">✓</span>
			<h2>You have finished the course</h2>
			@learnFinishedBody()
		</div>
	</div>
}
