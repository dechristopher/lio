package view

import "strconv"

// Profile renders a public player page: identity, ratings, record and recent
// games. A closed (banned) account renders a neutral card in place of all of
// it — no reason, no duration, which are moderator-only. Moderators see the
// same page plus a moderation bar; that bar is a convenience, never the
// authorization boundary, since every action it posts is re-checked server-side.
templ Profile(meta Meta, m ProfileModel) {
	@base(meta) {
		<body>
			<div class="page">
				@header("w-[92vw] max-w-[44rem]")
				<main class="w-[92vw] max-w-[44rem] text-left">
					@profileIdentity(m)
					if m.Closed {
						@profileClosed()
					} else {
						@profileRatings(m)
						@profileRecords(m)
						@profileGames(m)
					}
					if m.ShowMod {
						@modBar(m)
					}
				</main>
				@footer(meta, "max-w-[44rem]")
			</div>
			if m.ShowMod {
				@confirmActionModal()
			}
		</body>
		@scriptsBase(meta)
		if m.ShowMod {
			<script src={ asset("lio-mod.js") }></script>
		}
	}
}

// profileIdentity is the name header: title badge, username, join month, and
// the viewer's own head-to-head against this account when the two have met.
templ profileIdentity(m ProfileModel) {
	<div class="card mb-3">
		<h1 class="flex min-w-0 flex-wrap items-center gap-1.5 font-display text-xl font-bold">
			@playerTitle(m.Title)
			<span class="min-w-0 truncate">{ m.Username }</span>
		</h1>
		<p class="mt-1 text-sm text-fg-subtle">
			if m.Joined != "" {
				Member since { m.Joined }
			}
		</p>
		if m.H2HShow {
			<p class="mt-2 text-sm text-fg-muted">Your record against { m.Username }: <span class="font-semibold text-fg">{ m.H2H }</span></p>
		}
	</div>
}

// profileClosed is the public state of a banned account. Deliberately neutral:
// it names no reason and no expiry (a moderator sees those in the mod bar; the
// account holder is told at the login refusal). It exists at all so an opponent
// who was wronged can see that something was done.
templ profileClosed() {
	<div class="card mb-3">
		<p class="text-sm font-semibold text-fg">This account is closed.</p>
		<p class="mt-1 text-sm text-fg-subtle">Its games remain in the archive.</p>
	</div>
}

// profileRatings lists the account's rating per time control it has actually
// played. Nothing renders for an account with no rated games — a rating that
// has never been earned is not worth a placeholder.
templ profileRatings(m ProfileModel) {
	if len(m.Ratings) > 0 {
		<div class="card mb-3">
			<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Ratings</p>
			<ul class="mt-3 flex flex-wrap gap-2">
				for _, r := range m.Ratings {
					<li class="rating-tile">
						<span class="rating-tile-cat">{ r.Category }</span>
						<span class="rating-tile-value">{ r.Rating }</span>
						<span class="rating-tile-games">{ pluralGames(r.Games) }</span>
					</li>
				}
			</ul>
		</div>
	}
}

// profileRecords is the win/draw/loss picture: lifetime, split by time control,
// and against each bot persona.
templ profileRecords(m ProfileModel) {
	<div class="card mb-3">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Record</p>
		<div class="mt-3">
			@recordRow("All games", m.Total)
		</div>
		if len(m.Variants) > 0 {
			<ul class="mt-2 flex flex-col gap-1">
				for _, v := range m.Variants {
					<li>
						@recordRow(v.Name+" "+v.Group, v.RecordView)
					</li>
				}
			</ul>
		}
		if len(m.Bots) > 0 {
			<p class="mt-4 text-xs font-semibold uppercase tracking-wider text-fg-muted">Versus the computer</p>
			<ul class="mt-2 flex flex-col gap-1">
				for _, b := range m.Bots {
					<li>
						@recordRow(botRecordLabel(b), b.RecordView)
					</li>
				}
			</ul>
		}
	</div>
}

// recordRow renders one labeled W/D/L line.
templ recordRow(label string, r RecordView) {
	<div class="record-row">
		<span class="record-label">{ label }</span>
		<span class="record-wdl">
			<span class="record-win">{ r.Wins }</span>
			<span class="record-sep">/</span>
			<span class="record-draw">{ r.Draws }</span>
			<span class="record-sep">/</span>
			<span class="record-loss">{ r.Losses }</span>
		</span>
		<span class="record-total">{ r.Games } games</span>
	</div>
}

// profileGames is the recent-games list, each row linking into the archive.
templ profileGames(m ProfileModel) {
	<div class="card mb-3">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Recent games</p>
		if len(m.Games) == 0 {
			<p class="mt-3 text-sm text-fg-subtle">No games yet.</p>
		} else {
			<ul class="mt-3 flex flex-col gap-1">
				for _, g := range m.Games {
					<li>
						<a href={ templ.SafeURL(g.URL) } class="game-row">
							<span class={ "game-result " + g.Class }>{ g.Result }</span>
							<span class="game-opponent">
								if g.OppTitle != "" {
									<span class="player-title">{ g.OppTitle }</span>
								}
								{ g.Opponent }
							</span>
							<span class="game-variant">{ g.Variant }</span>
							<span class="game-mode">{ g.Mode }</span>
							<span class="game-when">{ g.When }</span>
						</a>
					</li>
				}
			</ul>
		}
	</div>
}

// modBar is the moderation control panel, rendered only for a viewer who may
// moderate this account. Its forms are wired by lio-mod.js against /api/mod.
// Every control requires a reason: the audit log is the accountability model
// for the tools, and an unexplained action is not one other moderators can
// review.
templ modBar(m ProfileModel) {
	<div class="card mb-3 mod-bar">
		if m.Mod.IsSelf {
			<p class="text-xs font-semibold uppercase tracking-wider text-warn">⚑ Your account</p>
			<p class="mt-1 text-xs text-fg-subtle">
				Banning and role changes are not available on your own account.
			</p>
		} else {
			<p class="text-xs font-semibold uppercase tracking-wider text-warn">⚑ Moderation</p>
		}
		if m.Mod.OpenReports > 0 {
			<!-- Context before action: a moderator arriving from the queue should
			     see this is not the only complaint, and one arriving from
			     anywhere else should see there is a queue entry at all. -->
			<p class="mt-1 text-xs">
				<a class="font-semibold text-loss" href="/moderation">{ openReportsLabel(m.Mod.OpenReports) }</a>
			</p>
		}
		<form id="modForm" class="mt-3 flex flex-col gap-3" data-user-id={ strconv.FormatInt(m.UserID, 10) } data-username={ m.Mod.Username } novalidate>
			<div class="flex flex-wrap items-end gap-2">
				<label class="auth-label">
					Title
					<select class="auth-input" name="title">
						<option value="">— none —</option>
						for _, t := range m.Mod.Titles {
							<option value={ t.ID } selected?={ t.ID == m.Mod.CurrentTitleID }>{ t.Code } — { t.Name }</option>
						}
					</select>
				</label>
				<button
						type="button"
						class="btn btn-ghost"
						data-mod-action="title"
						data-effect="Shows beside their name everywhere it renders. Reversible at any time."
					>Set title</button>
			</div>
			if m.Mod.CanSetRole {
				<div class="flex flex-wrap items-end gap-2">
					<label class="auth-label">
						Role
						<select class="auth-input" name="role">
							for _, r := range m.Mod.Roles {
								<option value={ r } selected?={ r == m.Mod.CurrentRole }>{ r }</option>
							}
						</select>
					</label>
					<button
							type="button"
							class="btn btn-ghost"
							data-mod-action="role"
							data-effect="Changes what this account is allowed to do, and signs it out so the new role takes effect immediately."
						>Set role</button>
				</div>
			}
			<div class="flex flex-wrap items-end gap-2">
				<label class="auth-label">
					New username
					<input class="auth-input" name="username" type="text" minlength="3" maxlength="20" placeholder="Forced rename"/>
				</label>
				<button
						type="button"
						class="btn btn-ghost"
						data-mod-action="rename"
						data-effect="Their old name stops resolving. Archived games keep showing the name they played under."
					>Rename</button>
			</div>
			if m.Mod.Banned {
				<div class="mod-ban-state">
					<p class="text-sm font-semibold text-loss">Banned { m.Mod.BanUntil }</p>
					if m.Mod.BanReason != "" {
						<p class="text-sm text-fg-muted">{ m.Mod.BanReason }</p>
					}
					<button
							type="button"
							class="btn btn-ghost mt-2"
							data-mod-action="unban"
							data-confirm="Lift the ban"
							data-effect="They can log in again. Any game the ban forfeited stays forfeited."
						>Lift ban</button>
				</div>
			} else if m.Mod.CanBan {
				<div class="flex flex-wrap items-end gap-2">
					<label class="auth-label">
						Ban
						<select class="auth-input" name="duration">
							<option value="24h">24 hours</option>
							<option value="168h">7 days</option>
							<option value="720h">30 days</option>
							<option value="permanent">Permanently</option>
						</select>
					</label>
					<button
							type="button"
							class="btn btn-danger"
							data-mod-action="ban"
							data-effect="Ends any game in progress as a forfeit, signs them out everywhere, and blocks login. It does not stop anonymous play."
						>Ban account</button>
				</div>
			}
		</form>
		if len(m.Mod.Actions) > 0 {
			<div class="mt-4 border-t border-line pt-3">
				<div class="flex flex-wrap items-baseline justify-between gap-2">
					<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">History</p>
					<p class="text-xs text-fg-subtle">{ modHistoryLabel(m.Mod) }</p>
				</div>
				<ul class="mt-2 flex flex-col gap-1">
					for _, a := range m.Mod.Actions {
						<!-- the same row the /system feed renders, minus the target: on
						     this page the target IS the page. One component, so the two
						     views of one log cannot drift apart. -->
						@auditRow(a, false)
					}
				</ul>
				if m.Mod.HistoryURL != "" {
					<a href={ templ.SafeURL(m.Mod.HistoryURL) } class="mt-2 inline-block text-xs font-semibold text-accent">
						See everything involving this account →
					</a>
				}
			</div>
		}
	</div>
}
