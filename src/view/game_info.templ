package view

import (
	"strconv"

	"github.com/dechristopher/lio/message"
)

// gameSummary renders the at-a-glance match details shown on both pre-game
// views as a labeled spec list — one fact per row, label left, value right —
// so the settings are scannable instead of buried in a dot-separated prose run
// that grows unreadable once race-to and rated stack onto it.
//
// The rows are Time (clock notation + pace, with the plain-language decode as a
// footnote), the color this viewer plays, the pre-game format, the scoring, and
// — only for a race-to room — the match length. PlayerColor is the viewer's
// color for the creator and the open-seat color for the joiner (set in
// HandlePreGame), so "You play …" reads correctly for both. When BlindColor is
// set (the creator chose random), the concrete color is hidden behind a
// half/half indicator + "Random" for both players — the board reveals it only
// once the game begins. colorDot is reused from the home page.
templ gameSummary(payload message.RoomTemplatePayload) {
	<dl class="spec">
		<div class="spec-row">
			<dt class="spec-label">Time</dt>
			<dd class="spec-value">
				<span class="spec-tc">{ payload.Variant.Name }</span>
				<span class="spec-speed">{ speedLabel(payload.Variant) }</span>
			</dd>
		</div>
		<div class="spec-row">
			<dt class="spec-label">You play</dt>
			<dd class="spec-value">
				if payload.BlindColor {
					// random color: hide the resolved side from both players until the
					// board reveals it at game start (half/half indicator + neutral copy)
					@colorDot("r")
					<span>Random</span>
				} else {
					@colorDot(payload.PlayerColor)
					if payload.PlayerColor == "w" {
						<span>White</span>
					} else {
						<span>Black</span>
					}
				}
			</dd>
		</div>
		<div class="spec-row">
			<dt class="spec-label">Format</dt>
			<dd class="spec-value">{ formatLabel(payload.Variant) }</dd>
		</div>
		if payload.RaceTo > 0 {
			<div class="spec-row">
				<dt class="spec-label">Match</dt>
				<dd class="spec-value">Race to { strconv.Itoa(payload.RaceTo) }</dd>
			</div>
		}
		<div class="spec-row">
			<dt class="spec-label">Scoring</dt>
			<dd class="spec-value">
				if payload.Rated {
					<span class="spec-rated">Rated</span>
				} else {
					<span>Unrated</span>
				}
			</dd>
		</div>
	</dl>
	// plain-language decode of the clock notation, so newcomers know exactly
	// what they're signing up for without parsing "½ + 1"
	<p class="wait-note spec-note">{ humanClock(payload.Variant) }</p>
}
