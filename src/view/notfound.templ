package view

// NotFound is the 404 page. Like the old template it wraps the main layout but
// omits the footer and the shared client scripts.
templ NotFound(meta Meta) {
	@base(meta) {
		<body>
			<div class="page">
				@header("w-[92vw] max-w-[34rem]")
				<div class="mt-10 flex flex-col items-center gap-1.5 text-center text-fg-muted">
					<span class="font-display text-6xl font-extrabold leading-none text-fg">404</span>
					<span class="font-medium">This page doesn't exist.</span>
					<span>The link may be old or mistyped.</span>
					<div class="mt-3 flex gap-2">
						<button type="button" class="btn btn-ghost" onclick="back()">← Go back</button>
						<a href="/" class="btn btn-primary no-underline">Play a game</a>
					</div>
				</div>
			</div>
		</body>
<script>
	let hasHistory = false;

	window.addEventListener('beforeunload', function () {
		hasHistory = true;
	});

	const back = () => {
		window.history.go(-1);
		setTimeout(function () {
			if (!hasHistory) {
				window.location = '/';
			}
		}, 200);
		return false;
	};
</script>
	}
}
