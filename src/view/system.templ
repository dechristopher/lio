package view

import "strconv"

// System renders one page of the site console. Per-player actions are not here
// by design — they live on the player page, where the moderator can see who
// they are acting on.
//
// The console is three routes, grouped by what an operator is doing (see
// SystemTab). Each renders only its own cards, and the handler loads only their
// data.
//
// The page widens with the viewport — 44rem, then 3xl, then 5xl — because the
// cards sit two abreast above md. The ladder is the home page's, one step
// wider at the base: this content was always denser than the home column.
templ System(meta Meta, m SystemModel) {
	@base(meta) {
		<body>
			<div class="page">
				@header(systemWidth)
				<main class={ systemWidth + " pb-6 text-left" }>
					<h1 class="font-display text-xl font-bold">System</h1>
					@systemTabs(m)
					switch m.Tab {
						case TabPeople:
							@systemPeople(m)
						case TabLog:
							@auditFeed(m)
						default:
							@systemOverview(m)
					}
				</main>
				@footer(meta, "max-w-[44rem] md:max-w-3xl lg:max-w-5xl")
			</div>
			if m.IsAdmin {
				@confirmActionModal()
			}
		</body>
		@scriptsBase(meta)
		<script src={ asset("lio-mod.js") }></script>
	}
}

// systemWidth is the console's responsive width, shared by the header, the main
// column and the footer so the three cannot drift apart.
const systemWidth = "w-[92vw] max-w-[44rem] md:max-w-3xl lg:max-w-5xl"

// systemTabs is the page strip.
//
// Plain links, deliberately, where the About page's tabs are htmx swaps. Two
// reasons, and the second is the decisive one:
//
//   - The console already navigates this way. Every action in lio-mod.js posts
//     and then reloads, because a moderation action must be shown as the server
//     recorded it; a tab change is cheaper than what the page already does after
//     every button.
//   - lio-mod.js resolves its forms once, at load. A swapped-in Site tab would
//     leave its broadcast composer holding a null form — the controller would
//     look present and do nothing, which is the worst failure available to a
//     surface that sends messages to every account.
//
// About swaps because its content is static prose with no controller behind it.
templ systemTabs(m SystemModel) {
	<nav class="sys-tabs" aria-label="Console sections">
		for _, tab := range SystemTabs {
			if tab == m.Tab {
				<a class="sys-tab is-active" href={ templ.SafeURL(tab.Path()) } aria-current="page">{ tab.Label() }</a>
			} else {
				<a class="sys-tab" href={ templ.SafeURL(tab.Path()) }>{ tab.Label() }</a>
			}
		}
	</nav>
}

// systemOverview is the site itself: what is happening, what is overriding a
// default, the switches that set them, and the process underneath.
//
// The live picture and the controls are one page deliberately. "What is
// happening" and "what do I turn" are the same question during an incident, and
// splitting them put a navigation between reading the answer and acting on it.
//
// **Active notices runs full width, above the columns, at every size.** It is
// the page's alert line: "what is still switched on?" is the one question here
// whose answer must not depend on which column somebody happened to read first.
// Putting it above the grid rather than at the top of a column also means it
// stays first on a telephone, where a column is just the thing that comes
// before the other one. Its usual state — "nothing is overridden" — is worth
// the two lines it costs, because during an incident that is a positive answer
// rather than an empty card.
//
// Below it, the two columns are not two topics; they are one reading order
// folded in half. Above md they sit side by side, and below md the left column
// is read out in full before the right — so the split is chosen to make that
// single column come out in the order an operator wants it:
//
//	what is overridden                                    (full width)
//	what is happening  →  the process  →  the switches    (left)
//	tell everybody     →  what was told                   (right)
//
// The left column is this instance and the switches that govern it; the right
// is everything outbound. The instance panel sits directly under the live
// picture because the two are the same kind of reading — what the site and the
// process are doing right now — one a level below the other.
templ systemOverview(m SystemModel) {
	if m.IsAdmin {
		@activeNotices(m)
		<div class="sys-grid">
			<div class="sys-col">
				@liveOps(m)
				@instancePanel(m.Stats)
				@siteControls(m)
			</div>
			<div class="sys-col">
				@broadcastComposer()
				@sentBroadcasts(m.Broadcasts)
			</div>
		</div>
	} else {
		// A moderator sees none of the admin cards, so there is no second column
		// to make — and a lone card at half width reads as a layout that failed
		// rather than one with nothing to put beside it.
		@liveOps(m)
	}
}

// systemPeople is the community half of the console.
//
// The feedback inbox and the message composer stay adjacent, in that order, in
// the same column. Feedback has no reply thread — the dialog says so — and
// writing to the player is the nearest thing to an answer; splitting them
// across columns would put the reply beside a different question.
templ systemPeople(m SystemModel) {
	<div class="sys-grid">
		<div class="sys-col">
			@FeedbackInboxSection(m.Feedback)
			@messagePlayer()
		</div>
		<div class="sys-col">
			@staffPanel(m.Staff)
		</div>
	</div>
}

// messagePlayer is the operator message composer (arch/NOTIFICATIONS.md
// Phase 3): find one player, write to them, send. The message arrives in their
// bell as a system notification.
//
// It sits under the feedback inbox on purpose. Feedback has no reply thread —
// the dialog says so — and this is the nearest thing to an answer: a moderator
// reading a report of a broken clock can tell that player it is fixed.
//
// A search box rather than a list of accounts. The site has more players than
// any select could hold, and an operator writing to somebody already knows who;
// typing two characters of a name is faster than finding it in a directory.
templ messagePlayer() {
	<div class="card mt-3">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Message a player</p>
		<p class="mt-2 text-sm text-fg-subtle">
			Goes straight to their notifications. It comes from the site, not from you by name.
		</p>
		<div class="msg-compose mt-3">
			<label class="auth-label">
				Player
				<input
					id="msgSearch"
					class="auth-input"
					type="text"
					autocomplete="off"
					placeholder="Start typing a username"
					aria-describedby="msgPicked"
				/>
			</label>
			// The picker's results and the chosen player share one slot, so the
			// card does not change height as somebody types and selects.
			<div id="msgResults" class="msg-results" role="listbox" aria-label="Matching players"></div>
			<p id="msgPicked" class="msg-picked hidden"></p>
			<label class="auth-label">
				Message
				<textarea id="msgBody" class="auth-input" rows="3" maxlength="500" placeholder="What do you want them to know?"></textarea>
			</label>
			@answerOptions("msgChoices", "Leave empty unless they must answer")
			<p id="msgError" class="auth-error hidden" role="alert"></p>
			<p id="msgOk" class="auth-ok hidden" role="status"></p>
			<button type="button" id="msgSend" class="btn btn-primary justify-center py-1.5" disabled>Send</button>
		</div>
	</div>
}

// answerOptions is the control that turns a message into a question
// (arch/NOTIFICATIONS.md, *A message can ask a question*). Shared by both
// composers, because the flag belongs to notifications rather than to
// broadcasts and the two must not offer it differently.
//
// One free-text field rather than a preset picker. The useful sets differ by
// what is being asked — one "OK" for a change somebody must confirm they saw,
// "Yes"/"No" for an offer worth counting — and a dropdown of three presets
// would be a list of guesses about a question nobody has written yet. The field
// is empty by default, which is the ordinary message.
templ answerOptions(id string, help string) {
	<label class="auth-label">
		Answer options
		// name as well as id: the broadcast composer is a form and its controller
		// reads form.elements, while the one-player composer is not and reads by
		// id. One component serves both.
		<input
			id={ id }
			name="choices"
			class="auth-input"
			type="text"
			autocomplete="off"
			maxlength="120"
			placeholder="OK — or Yes, No"
			aria-describedby={ id + "Help" }
		/>
	</label>
	<p id={ id + "Help" } class="-mt-1 text-xs text-fg-subtle">
		Separate with commas. A message with options stays in the bell until it is
		answered. { help }
	</p>
}

// broadcastComposer sends one message to every account
// (arch/NOTIFICATIONS.md, *A broadcast is one row*).
//
// Admin-only, and that is the line /system already draws: writing to one player
// is moderator work; anything every visitor sees belongs with the site
// controls. It sits under the one-player composer so the pair reads as a
// choice of audience.
//
// It goes through the confirmation modal, unlike the composer above it. That
// one is deliberately unconfirmed because a message to one player is frequent
// and small; this reaches every account at once and cannot be recalled — only
// retired, after everyone has already seen it.
templ broadcastComposer() {
	<div class="card mt-3 mod-bar">
		<p class="text-xs font-semibold uppercase tracking-wider text-warn">⚑ Broadcast</p>
		// No "below" or "beside": the site notice is above this card on a
		// telephone and next to it on a desktop, so the copy names the control
		// rather than pointing at where it happens to sit.
		<p class="mt-2 text-sm text-fg-subtle">
			Goes to the notification bell of every account, one row for the whole site.
			Signed-out visitors do not have a bell — the site notice is what reaches them.
		</p>
		<form id="broadcastForm" class="msg-compose mt-3" novalidate>
			<label class="auth-label">
				Message
				<textarea name="body" class="auth-input" rows="3" maxlength="500" placeholder="What does everybody need to know?"></textarea>
			</label>
			<label class="auth-label">
				Link
				<input name="link" class="auth-input" type="text" autocomplete="off" maxlength="200" placeholder="/news — optional, a path on this site"/>
			</label>
			@answerOptions("bcChoices", "An offer with options can be tallied below.")
			<div class="flex flex-wrap items-end gap-2">
				<label class="auth-label">
					Runs for
					<select name="expiresDays" class="auth-input">
						<option value="0">Until I retire it</option>
						<option value="1">1 day</option>
						<option value="7">7 days</option>
						<option value="30">30 days</option>
					</select>
				</label>
				<button
					type="button"
					class="btn btn-primary py-1.5"
					data-broadcast
					data-confirm="Broadcast to every account"
					data-effect="Every account sees this in their notification bell, immediately. It can be retired afterwards, but not unsent."
				>Send to everyone</button>
			</div>
		</form>
	</div>
}

// sentBroadcasts is what has been sent, newest first, with how each question
// was answered and a way to pull one that is still running.
//
// It is directly under the composer because the two are one loop: an offer is
// only worth sending if the answers come back somewhere, and the retire control
// has to be next to the thing it retires.
templ sentBroadcasts(items []BroadcastView) {
	<div class="card mt-3">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Sent broadcasts</p>
		if len(items) == 0 {
			<p class="mt-3 text-sm text-fg-subtle">Nothing has been broadcast yet.</p>
		} else {
			<ul class="mt-3 flex flex-col gap-1.5">
				for _, b := range items {
					@broadcastRow(b)
				}
			</ul>
		}
	</div>
}

// broadcastRow is one sent message. Live and retired rows use the same shape,
// tinted by state: a retired message is history and must stay readable, because
// the answers it collected are the reason it was sent.
templ broadcastRow(b BroadcastView) {
	<li class={ "bc-row", templ.KV("is-live", b.Live) }>
		<div class="bc-head">
			<time class="bc-when" title={ b.WhenExact }>{ b.When }</time>
			if b.Live {
				<span class="bc-state bc-live" title="Still showing in every account's bell">live</span>
			} else {
				<span class="bc-state bc-ended" title="No longer shown">ended</span>
			}
			if b.Actor != "" {
				<a class="bc-actor" href={ templ.SafeURL("/@/" + b.Actor) } title="Admin who sent it">{ b.Actor }</a>
			}
			if b.Ends != "" {
				<span class="bc-ends" title={ b.EndsExact }>
					if b.Live {
						ends { b.Ends }
					} else {
						ended { b.Ends }
					}
				</span>
			}
			if b.Live {
				<button
					type="button"
					class="btn btn-ghost bc-retire"
					data-retire-broadcast={ b.ID }
					data-confirm="Retire this broadcast"
					data-effect="It stops showing in every account's bell. Answers already given are kept."
				>Retire</button>
			}
		</div>
		<p class="bc-body">{ b.Body }</p>
		if b.Link != "" {
			<a class="bc-link" href={ templ.SafeURL(b.Link) }>{ b.Link }</a>
		}
		if len(b.Asks) > 0 {
			<div class="bc-tally">
				<span class="bc-tally-label">{ BroadcastAnswersLabel(b) }</span>
				if len(b.Tally) == 0 {
					// The options are still worth showing with no replies: they say
					// what was asked, which is the half a zero count cannot.
					for _, choice := range b.Asks {
						<span class="bc-chip bc-chip-empty" title="Nobody has chosen this">
							<span class="bc-chip-key">{ choice }</span>
							<span class="bc-chip-value">0</span>
						</span>
					}
				} else {
					for _, t := range b.Tally {
						<span class="bc-chip">
							<span class="bc-chip-key">{ t.Choice }</span>
							<span class="bc-chip-value">{ t.Count }</span>
						</span>
					}
				}
			</div>
		}
	</li>
}

// liveOps is the operational picture: who is here, what is running, and a way
// into any of it. It leads the page because "what is happening right now" is
// the question an operator opens this page with; the switches below are what
// they reach for once they know.
//
// Every room links through to itself — a moderator watching a suspected cheat
// spectates the game like anyone else rather than through a special viewer.
// Force-closing is the one action here, and it goes through the same control
// channel a resignation does.
templ liveOps(m SystemModel) {
	<div class="card mt-3">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Right now</p>
			<p class="text-xs text-fg-subtle">this instance</p>
		</div>
		<div class="mt-3 flex flex-wrap gap-2">
			@liveStat("Online", strconv.Itoa(m.Live.Online), "Distinct people connected to a room or on the home page")
			@liveStat("Games", strconv.Itoa(m.Live.LiveGames), "Games in progress")
			@liveStat("Challenges", strconv.Itoa(m.Live.OpenChallenges), "Open challenges waiting for an opponent")
		</div>
		if len(m.Live.Rooms) == 0 {
			<p class="mt-3 text-sm text-fg-subtle">No rooms are live.</p>
		} else {
			<ul class="mt-3 flex flex-col gap-1">
				for _, r := range m.Live.Rooms {
					<li class="live-room">
						<a class="live-room-id" href={ templ.SafeURL(r.URL) } title="Open the room — you join as a spectator">{ r.RoomID }</a>
						<span class="live-room-kind">{ r.Kind }</span>
						<span class="live-room-variant">{ r.Variant }</span>
						if r.VsBot {
							<span class="live-room-bot" title="Against the computer">bot</span>
						}
						<span class="live-room-moves">{ r.Moves }</span>
						if m.IsAdmin {
							<button
								type="button"
								class="btn btn-ghost live-room-close"
								data-close-room={ r.RoomID }
								data-confirm={ "Close room " + r.RoomID }
								data-effect="Ends the room for both players. A game in progress is abandoned, not resolved — use this to clear something stuck, not to decide a game."
							>Close</button>
						}
					</li>
				}
			</ul>
			if m.Live.Truncated > 0 {
				<p class="mt-2 text-xs text-fg-subtle">
					{ strconv.Itoa(m.Live.Truncated) } more not shown.
				</p>
			}
		}
	</div>
}

// liveStat is one counter tile.
templ liveStat(label string, value string, help string) {
	<div class="live-stat" title={ help }>
		<span class="live-stat-value">{ value }</span>
		<span class="live-stat-label">{ label }</span>
	</div>
}

// instancePanel is the process and the services behind it: how the Go runtime
// is doing, and whether Postgres, Redis and the object store are answering.
//
// It is admin-only. Nothing here is a control and nothing acts on a player, but
// it names infrastructure — hostnames, buckets, memory ceilings — which is the
// operator's business rather than the moderator's.
//
// The summary (build line, four headline numbers, a status pill per backend) is
// always visible; the full breakdown sits behind a disclosure, because ~35
// labelled figures above the site controls would bury them exactly when someone
// is reaching for them.
//
// The disclosure is a checkbox rather than a <details>, and it lives *outside*
// the htmx-swapped region on purpose: the panel refreshes itself every few
// seconds, and any open/closed state stored inside the swapped markup would
// snap shut under the operator mid-read.
//
// The poll pauses while the tab is hidden — every tick probes three backends,
// and a console left open in a background tab overnight should not keep pinging
// them. That gating lives in lio-mod.js rather than in an hx-trigger filter,
// because htmx evaluates filter expressions with the Function constructor and
// the site's CSP has no 'unsafe-eval': the inline form parses, then throws on
// every page load and gates nothing.
templ instancePanel(s SystemStats) {
	<div class="card mt-3">
		<input id="sysDetail" type="checkbox" class="sys-detail-toggle"/>
		<div class="sys-head flex flex-wrap items-baseline justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Instance</p>
			<label class="sys-toggle" for="sysDetail">
				<span class="sys-toggle-more">Show details</span>
				<span class="sys-toggle-less">Hide details</span>
			</label>
		</div>
		<div
			id="systemStats"
			class="sys-body"
			hx-get="/system/stats"
			hx-trigger="every 10s"
			hx-target="this"
			hx-swap="innerHTML"
		>
			@SystemStatsBody(s)
		</div>
	</div>
}

// SystemStatsBody is the swappable sample. Exported because it is served on its
// own as the polling fragment.
templ SystemStatsBody(s SystemStats) {
	<p class="sys-ident">
		<span class="sys-ident-build" title={ "Booted " + s.Runtime.BootExact }>{ s.Runtime.Version }</span>
		<span class="sys-ident-env" title="Deployment environment">{ s.Runtime.Env }</span>
		<span title="Go toolchain this binary was built with">{ s.Runtime.GoVer }</span>
		<span title="Operating system and architecture">{ s.Runtime.Platform }</span>
		<span title={ "Booted " + s.Runtime.BootExact }>up { s.Runtime.Uptime }</span>
	</p>
	<div class="mt-3 flex flex-wrap gap-2">
		for _, t := range s.Runtime.Tiles {
			<div class={ "live-stat", t.Class } title={ t.Help }>
				<span class="live-stat-value">{ t.Value }</span>
				<span class="live-stat-label">{ t.Label }</span>
			</div>
		}
	</div>
	<ul class="sys-backends">
		for _, b := range s.Backends {
			<li class="sys-backend">
				<span class={ "sys-dot", b.Class } aria-hidden="true"></span>
				<span class="sys-backend-name">{ b.Name }</span>
				<span class={ "sys-backend-status", b.Class }>{ b.Status }</span>
				if b.Latency != "" {
					<span class="sys-backend-latency" title="Round trip of a liveness probe just now">{ b.Latency }</span>
				}
				if b.Err != "" {
					<span class="sys-backend-err" title={ b.Err }>{ b.Err }</span>
				}
			</li>
		}
	</ul>
	<div class="sys-detail">
		@statSections("Go runtime", s.Runtime.Sections)
		for _, b := range s.Backends {
			if len(b.Sections) > 0 {
				@statSections(b.Name+" — "+b.Detail, b.Sections)
			}
		}
	</div>
	<p class="sys-sampled" title="This panel refreshes itself every 10 seconds">Sampled { s.Sampled } · this instance only</p>
}

// statSections renders one source's breakdown: a heading, then each group of
// labelled figures. Every row carries a tooltip because the vocabulary is
// internal — "EmptyAcquireCount" is obvious to whoever read pgxpool's source
// and opaque to the person reading this panel at 3am.
templ statSections(title string, sections []StatSection) {
	<div class="sys-group">
		<p class="sys-group-title">{ title }</p>
		for _, sec := range sections {
			<p class="sys-section-title">{ sec.Title }</p>
			<dl class="sys-rows">
				for _, r := range sec.Rows {
					<div class="sys-row" title={ r.Help }>
						<dt class="sys-row-label">{ r.Label }</dt>
						<dd class={ "sys-row-value", r.Class }>{ r.Value }</dd>
					</div>
				}
			</dl>
		}
	</div>
}

// activeNotices lists everything currently deviating from the site's defaults,
// each with a one-click stand-down. It exists because the controls below answer
// "what can I change?" while the only question that matters during an incident
// — or a week later, when nobody remembers — is "what is still switched on?".
// Nothing here is a new capability: each X posts the same setting change the
// toggle below would, and carries the same required reason.
templ activeNotices(m SystemModel) {
	<div class="card mt-3">
		<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Active notices</p>
		if len(m.Active) == 0 {
			<p class="mt-3 text-sm text-fg-subtle">
				Nothing active — the site is running on its defaults.
			</p>
		} else {
			<ul class="mt-3 flex flex-col gap-1.5">
				for _, n := range m.Active {
					<li class={ "active-notice " + n.Class }>
						<span class="active-notice-body">
							<span class="active-notice-title">{ n.Title }</span>
							if n.Detail != "" {
								<span class="active-notice-detail">{ n.Detail }</span>
							}
						</span>
						<button
							type="button"
							class="active-notice-clear"
							data-setting={ n.Setting }
							data-value={ n.ClearValue }
							data-confirm={ "Stand down: " + n.Title }
							data-effect={ n.ClearEffect }
							aria-label={ "Stand down: " + n.Title }
							title="Stand down"
						>
							@iconClose()
						</button>
					</li>
				}
			</ul>
			<p class="mt-2 text-xs text-fg-subtle">
				Standing one down asks for a reason and is recorded like any other change.
			</p>
		}
	</div>
}

// siteControls is the runtime switches form. Each control posts on its own, so
// changing one switch never restates the rest of the site's configuration —
// and a stale form open in another tab cannot silently revert something.
templ siteControls(m SystemModel) {
	<div class="card mt-3 mod-bar">
		<p class="text-xs font-semibold uppercase tracking-wider text-warn">⚑ Site controls</p>
		<form id="settingsForm" class="mt-3 flex flex-col gap-3" novalidate>
			<div class="flex flex-col gap-2">
				<label class="auth-label">
					Site notice
					<input class="auth-input" name="noticeText" type="text" maxlength="300" value={ m.Settings.NoticeText } placeholder="Shown on every page & not dismissable"/>
				</label>
				<div class="flex flex-wrap items-end gap-2">
					<label class="auth-label">
						Style
						<select class="auth-input" name="noticeLevel">
							<option value="info" selected?={ m.Settings.NoticeLevel != "warn" }>Info</option>
							<option value="warn" selected?={ m.Settings.NoticeLevel == "warn" }>Warning</option>
						</select>
					</label>
					<button
						type="button"
						class="btn btn-ghost"
						data-setting="notice"
						data-confirm="Set the site notice"
						data-effect="Shown above the header on every page until it is cleared."
					>Set notice</button>
				</div>
			</div>
			<div class="mt-2 flex flex-col gap-2 border-t border-line pt-3">
				@settingToggle("registrationOpen", "New account registration", "Existing accounts keep signing in either way.", m.Settings.RegistrationOpen)
				@settingToggle("ratedEnabled", "Rated games", "Games already in progress keep the rating they started with.", m.Settings.RatedEnabled)
				@settingToggle("maintenance", "Maintenance mode", "Stops new games starting. Games in progress play out normally.", m.Settings.Maintenance)
			</div>
		</form>
	</div>
}

// settingToggle is one boolean switch: its current state and the button that
// flips it. The button says what it will *do*, not what the state is — a
// control labelled with its own state is the classic way to get an operator to
// turn the wrong thing off during an incident.
templ settingToggle(key string, label string, help string, on bool) {
	<div class="setting-row">
		<div class="min-w-0">
			<p class="text-sm font-semibold text-fg">
				{ label }
				if on {
					<span class="setting-state setting-on">on</span>
				} else {
					<span class="setting-state setting-off">off</span>
				}
			</p>
			<p class="text-xs text-fg-subtle">{ help }</p>
		</div>
		if on {
			<button
				type="button"
				class="btn btn-ghost shrink-0"
				data-setting={ key }
				data-value="0"
				data-confirm={ "Turn off: " + label }
				data-effect={ SettingEffect(key, false) }
			>Turn off</button>
		} else {
			<button
				type="button"
				class="btn btn-ghost shrink-0"
				data-setting={ key }
				data-value="1"
				data-confirm={ "Turn on: " + label }
				data-effect={ SettingEffect(key, true) }
			>Turn on</button>
		}
	</div>
}

// auditFeed is the global record of privileged actions, newest first. Every
// moderator sees every other moderator's entries: there is no silent
// moderation, and this feed is the accountability model for the tools.
//
// The log is permanent and append-only, so the page onto it needs to be
// navigable rather than a fixed window of the most recent entries — the entry
// that matters is usually the one someone is trying to find months later.
templ auditFeed(m SystemModel) {
	<div class="card my-3">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-wider text-fg-muted">Audit log</p>
			<p class="text-xs text-fg-subtle">{ auditCountLabel(m.Feed) }</p>
		</div>
		@auditFilters(m.Feed)
		<div id="auditFeed">
			@AuditFeedBody(m.Feed)
		</div>
	</div>
}

// auditFilters is the search + verb form. It GETs the same page, so a filtered
// view is a real URL someone can bookmark or paste into a ticket; htmx swaps
// the results in place when it is available, and the plain form submission is
// the fallback.
templ auditFilters(f AuditFeed) {
	<form
		class="mt-3 flex flex-wrap items-end gap-2"
		method="GET"
		action="/system/log"
		hx-get="/system/actions"
		hx-target="#auditFeed"
		hx-swap="innerHTML"
	>
		<label class="auth-label min-w-0 flex-1">
			Search
			<input class="auth-input" name="q" type="search" value={ f.Query } placeholder="Reason, or either account's name"/>
		</label>
		<label class="auth-label">
			Action
			<select class="auth-input" name="action">
				<option value="">All</option>
				for _, kind := range f.ActionKinds {
					<option value={ kind } selected?={ kind == f.Action }>{ kind }</option>
				}
			</select>
		</label>
		<button type="submit" class="btn btn-ghost">Filter</button>
		if f.Filtered {
			<a href="/system/log" class="btn btn-ghost no-underline">Clear</a>
		}
	</form>
}

// AuditFeedBody is the swappable results region: the entries plus the pager.
// Exported because it is served on its own as the htmx fragment.
templ AuditFeedBody(f AuditFeed) {
	if len(f.Actions) == 0 {
		if f.Filtered {
			<p class="mt-3 text-sm text-fg-subtle">No actions match that search.</p>
		} else {
			<p class="mt-3 text-sm text-fg-subtle">Nothing has been actioned yet.</p>
		}
	} else {
		<ul class="mt-3 flex flex-col gap-1.5">
			for _, a := range f.Actions {
				@auditRow(a, true)
			}
		</ul>
		if f.Pages > 1 {
			<div class="audit-pager">
				if f.PrevURL != "" {
					<a class="btn btn-ghost no-underline" href={ templ.SafeURL(f.PrevURL) } hx-get={ fragmentURL(f.PrevURL) } hx-target="#auditFeed" hx-swap="innerHTML">← Newer</a>
				} else {
					<span class="btn btn-ghost is-disabled">← Newer</span>
				}
				<span class="audit-pager-state">Page { strconv.Itoa(f.Page) } of { strconv.Itoa(f.Pages) }</span>
				if f.NextURL != "" {
					<a class="btn btn-ghost no-underline" href={ templ.SafeURL(f.NextURL) } hx-get={ fragmentURL(f.NextURL) } hx-target="#auditFeed" hx-swap="innerHTML">Older →</a>
				} else {
					<span class="btn btn-ghost is-disabled">Older →</span>
				}
			</div>
		}
	}
}

// auditRow renders one audit entry as a set of tinted, tooltipped fields.
//
// withTarget is false on a player page, where every entry is about that account
// and repeating its name on each row would be noise; the /system feed spans
// accounts, so it needs both parties and the site-wide marker.
//
// Everything carries a title attribute because the vocabulary here is internal:
// "forfeited=1" or "lifted=permanent" is obvious to whoever wrote the handler
// and opaque to the moderator reading it six weeks later. The row degrades
// sensibly when fields are absent — a site-level change has no target, and some
// actions carry no payload.
templ auditRow(a ModFeedEntry, withTarget bool) {
	<li class="audit-row">
		<time class="audit-when" title={ a.WhenExact }>{ a.When }</time>
		<span class={ "audit-action " + ActionClass(a.Action) } title={ ActionHelp(a.Action) }>{ a.Action }</span>
		<span class="audit-parties">
			<a class="audit-actor" href={ templ.SafeURL("/@/" + a.Actor) } title="Moderator who took this action">{ a.Actor }</a>
			if withTarget && a.Target != "" {
				<span class="audit-arrow" aria-hidden="true">→</span>
				<a class="audit-target" href={ templ.SafeURL("/@/" + a.Target) } title="Account this action was taken against">{ a.Target }</a>
			} else if withTarget {
				<span class="audit-sitewide" title="A site-wide change, not aimed at one account">site-wide</span>
			}
		</span>
		if len(a.Details) > 0 {
			<span class="audit-details">
				for _, d := range a.Details {
					<span class="audit-chip" title={ d.Help }>
						<span class="audit-chip-key">{ d.Key }</span>
						<span class="audit-chip-value">{ d.Value }</span>
					</span>
				}
			</span>
		}
		if a.Reason != "" {
			<span class="audit-reason" title="Reason the moderator gave; required on every action">{ a.Reason }</span>
		}
	</li>
}
