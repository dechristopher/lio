package view

import (
	"github.com/dechristopher/lio/pools"
	"github.com/dechristopher/lio/settings"
)

// createGameModal is the custom-game dialog opened from the home page. It is a
// horizontal two-panel layout — a left "setup" panel (opponent toggle, casual
// switch, rated status, and the open-challenge switch) and a right "time
// control" panel (race-to plus the shared time-control cards) — over a
// full-width action bar holding the play-as color submits.
// Every game is the blind-deploy variant — surfaced simply as "Octad", kept
// "deploy" under the hood — so there is no mode toggle: each time-control card
// carries its variant HTMLName and a small script writes the chosen one into the
// hidden time-control field the form submits. Choosing the computer as opponent
// fades + disables (never removes — a choice made *inside* the open dialog must
// not shift the layout under the person making it) the open-challenge toggle and
// the race-to picker; bot games are never public.
//
// Opening it as a direct challenge is the one exception: the opponent, the
// open-challenge toggle and the allow-anonymous toggle are hidden outright,
// because a challenge answers all three before the dialog opens and nothing
// inside it can change that (arch/NOTIFICATIONS.md Phase 2).
// The Casual (untimed) toggle applies to any opponent; turning it on fades the
// then-moot time-control cards. The rated status (see cg-rated) is passive: it
// lights when the current settings would produce a rated game (logged in, human
// opponent, competitive) and dims otherwise. When the computer is the opponent,
// the color submit is intercepted by botDifficultyModal (botmodal.templ), which
// asks for a bot difficulty before the form actually posts. Styling lives in
// app.css (.cg-* / .seg-* / .tc-* / .modal-*); the modal reuses the shared
// .modal-shade/.modal-close chrome.
//
// Below 34rem the dialog turns into a bottom sheet: a fixed-height box whose
// body scrolls under the pinned action bar, and where the moot controls
// collapse out of the flow instead of fading in place — the fade rule above
// buys its no-shift guarantee with vertical space a phone does not have. Both
// rules live in one block in app.css; read the reasoning there before changing
// either.
templ createGameModal() {
	<div id="modalCreateGame" class="modal-shade">
		<div class="modal cg-modal card">
			<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
			// The head doubles as the challenge header: opening the modal from a
			// player's sword swaps this copy to name them, so the dialog says who
			// the game is for rather than leaving that to a field nobody reads.
			<div class="cg-head">
				<span class="cg-kicker" data-cg-kicker>New game</span>
				<h2 class="cg-title" data-cg-title>Create a game</h2>
			</div>
			<form class="cg" action="/new/game" method="POST" hx-post="/new/game" data-bot-difficulty="custom">
				<div class="cg-body">
					<div class="cg-panel">
						// Hidden when the dialog is opened as a challenge: the opponent
						// is the player being challenged, so there is nothing to
						// choose. See app.css for why this one hides while the rest of
						// the dialog fades. Computer is disabled outright as well —
						// the server refuses an invitation on a bot game.
						<div class="cg-field cg-opponent">
							<span class="cg-label">Opponent</span>
							<div class="seg" role="radiogroup" aria-label="Opponent">
								<input id="opp-human" class="seg-input" type="radio" name="opponent" value="human" checked/>
								<label class="seg-btn" for="opp-human">
									@iconUsers("seg-ico")
									<span>Human</span>
								</label>
								<input id="opp-computer" class="seg-input" type="radio" name="opponent" value="computer"/>
								<label class="seg-btn" for="opp-computer">
									@iconCpu("seg-ico")
									<span>Computer</span>
								</label>
							</div>
						</div>
						<label class="cg-toggle cg-casual">
							<input type="checkbox" class="cg-toggle-box cg-casual-box" name="casual" value="true"/>
							<span class="cg-toggle-text">
								<span class="cg-toggle-title">Casual mode</span>
								<span class="cg-toggle-hint">Unrated game & unlimited time<br/>Think as long as you like</span>
							</span>
							<span class="cg-switch" aria-hidden="true"></span>
						</label>
						// Rated status + control. A game is rated only when a logged-in
						// player faces another real player in a competitive (non-casual)
						// game. The badge lights for that case and dims (via :has() on the
						// opponent/casual/allow-anon inputs) otherwise. The "Allow anonymous
						// players" toggle below is the opt-out: it opens the game to anon
						// joiners and so makes it unrated. An anonymous creator instead
						// gets the locked variant, since rated play needs an account. Kept
						// always-visible to avoid layout shift.
						if !settings.Current().RatedEnabled {
							@ratedPausedBadge()
						} else if viewer(ctx).LoggedIn {
							<div class="cg-rated" aria-live="polite">
								<span class="cg-rated-badge">
									@iconTrophy("cg-rated-ico")
									RATED
								</span>
								<span class="cg-rated-copy">
									<span class="cg-rated-line" data-state="on">Counts toward your rating</span>
									<span class="cg-rated-line" data-state="open">Open game — anyone can join, unrated</span>
									<span class="cg-rated-line" data-state="off">Just for fun — unrated</span>
								</span>
							</div>
						}
						if viewer(ctx).LoggedIn {
							<label class="cg-toggle cg-allow-anon">
								<input type="checkbox" class="cg-toggle-box cg-allow-anon-box" name="allow_anon" value="true"/>
								<span class="cg-toggle-text">
									<span class="cg-toggle-title">Allow anonymous players</span>
									<span class="cg-toggle-hint">On = anyone can join (unrated)<br/>Off = logged-in players only (rated)</span>
								</span>
								<span class="cg-switch" aria-hidden="true"></span>
							</label>
						} else if viewer(ctx).AccountsEnabled && settings.Current().RatedEnabled {
							// only worth inviting an anonymous visitor to log in for rated
							// play while rated play actually exists
							<div class="cg-rated cg-rated-locked">
								<span class="cg-rated-badge">
									@iconLock("cg-rated-ico")
									RATED
								</span>
								<span class="cg-rated-copy">
									<a href="#" onclick="document.getElementById('modalAccount').classList.add('open');return false;">Log in</a> to play rated games
								</span>
							</div>
						}
						<label class="cg-toggle cg-public">
							<input type="checkbox" class="cg-toggle-box cg-public-box" name="public" value="true"/>
							<span class="cg-toggle-text">
								<span class="cg-toggle-title">Open challenge</span>
								<span class="cg-toggle-hint">On = anyone can join the game<br/>Off = only your link works</span>
							</span>
							<span class="cg-switch" aria-hidden="true"></span>
						</label>
					</div>
					<div class="cg-panel cg-panel-hero">
						<div class="cg-field cg-race">
							<span class="cg-label">Race to</span>
							<div class="seg" role="radiogroup" aria-label="Race to (match length)">
								<input id="race-0" class="seg-input" type="radio" name="race-to" value="0" checked/>
								<label class="seg-btn" for="race-0">
									<span>Off</span>
								</label>
								<input id="race-3" class="seg-input" type="radio" name="race-to" value="3"/>
								<label class="seg-btn" for="race-3">
									<span>3</span>
								</label>
								<input id="race-5" class="seg-input" type="radio" name="race-to" value="5"/>
								<label class="seg-btn" for="race-5">
									<span>5</span>
								</label>
								<input id="race-7" class="seg-input" type="radio" name="race-to" value="7"/>
								<label class="seg-btn" for="race-7">
									<span>7</span>
								</label>
							</div>
							<span class="cg-hint"><strong>Race:</strong> games run back-to-back until a player reaches the target score — draws count ½. Human opponents only.</span>
						</div>
						<div class="cg-field cg-tc">
							<span class="cg-label">Time control</span>
							<div class="tc-select">
								for _, ctrl := range pools.CreateControls {
									<input
										id={ ctrl.Deploy.HTMLName }
										class="tc-input"
										type="radio"
										name="tc-choice"
										data-variant={ ctrl.Deploy.HTMLName }
										required
									/>
									<label class="tc-label" for={ ctrl.Deploy.HTMLName }>
										<span class="tc-box">
											<span class="tc-name">{ ctrl.Label }</span>
											<span class="tc-pool">{ ctrl.Group.String() }</span>
										</span>
									</label>
								}
							</div>
						</div>
					</div>
				</div>
				// The color submits are the dialog's primary action, so they sit in
				// their own full-width footer rather than at the foot of the right
				// panel. On phones the dialog is a sheet whose body scrolls under
				// this bar, so "start the game" is reachable at any scroll position
				// — the reason the field was pulled out of the panel (see app.css).
				<div class="cg-foot">
					<span class="cg-label">Play as</span>
					<div class="submit-row">
						<button type="submit" class="submit-btn" name="color" value="w" title="Play the white pieces first">
							<span class="piece-button wk"></span>
						</button>
						<button type="submit" class="submit-btn large" name="color" value="r" title="Play either color first">
							<span class="piece-button random"></span>
						</button>
						<button type="submit" class="submit-btn" name="color" value="b" title="Play the black pieces first">
							<span class="piece-button bk"></span>
						</button>
					</div>
					<span class="cg-gate-hint">Pick a time control, then choose your color to start.</span>
				</div>
				<input type="hidden" name="time-control" id="cg-variant" value=""/>
				// the direct-challenge target (arch/NOTIFICATIONS.md Phase 2).
				// Empty for an ordinary creation; set when the modal is opened
				// from a player's sword. The server re-validates the name — this
				// field is as forgeable as any other.
				<input type="hidden" name="invite" id="cg-invite" value=""/>
			</form>
		</div>
	</div>
	<link rel="prefetch" href="/res/img/cburnett/wK.svg"/>
	<link rel="prefetch" href="/res/img/cburnett/bK.svg"/>
	<link rel="prefetch" href="/res/img/cburnett/wbK.svg"/>
}

// ratedPausedBadge replaces the interactive rated-status display while ratings
// are paused site-wide (/system). The live badge is swapped out rather than
// driven to its "off" state because no combination of the controls beside it
// can produce a rated game right now — a status display that still reacted to
// them would be describing a choice the visitor does not have.
//
// Time controls and the casual toggle are deliberately untouched: a paused
// rating pool is no reason to take clocks away, and the server already forces
// Rated off regardless of what the form submits.
templ ratedPausedBadge() {
	<div class="cg-rated cg-rated-paused" role="status">
		<span class="cg-rated-badge">
			@iconTrophy("cg-rated-ico")
			UNRATED
		</span>
		<span class="cg-rated-copy">
			<span class="cg-rated-line" data-state="on">Rated games are temporarily disabled</span>
		</span>
	</div>
}
