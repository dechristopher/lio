package view

import "github.com/dechristopher/lio/message"

// roomCreator is the creator's pre-game waiting view: a status head over a
// two-panel body — the match spec on one side, the invite on the other — with
// the cancel action alone in a quiet footer row.
//
// The QR anchors the invite panel, giving that column enough mass to sit level
// with the spec list instead of leaving the dead space the old single-column
// hero had. A logged-in creator sees a "Playing as …" identity line in the head.
//
// The panels are ordered invite-then-spec in the DOM: on phones the share
// actions are what the creator came for, so they lead, and the interactive
// controls come first in tab order; CSS reverses the visual order from 40rem up
// so desktop reads match → invite.
//
// Below 40rem the invite condenses to three rows — an OS share-sheet button
// (#shareInviteButton, unhidden by lio-room-create.js only where
// navigator.share exists), the link with its copy and QR icon buttons, and the
// caption — with the code itself moved into the #modalQR dimming modal behind
// the QR button. From 40rem up that modal flattens (see the markup note) and
// the code sits inline above the link instead.
// lio-room-create.js wires #copyInviteButton (toggling .copied) and reads
// #gameInviteLink, so those hooks are preserved. It waits over the websocket
// for an opponent.
templ roomCreator(meta Meta, payload message.RoomTemplatePayload) {
	<main class="wait card mt-2 mb-4">
		<div class="wait-head">
			if payload.Public {
				<span class="wait-kicker">Open challenge</span>
			} else {
				<span class="wait-kicker">Private challenge</span>
			}
			<div class="waiting-status">
				<span class="waiting-dot" aria-hidden="true"></span>
				<h1 class="wait-title">Looking for an opponent…</h1>
			</div>
			if payload.Public {
				<p class="wait-sub">Your game is listed on the home page. The first player to join plays you.</p>
			} else {
				<p class="wait-sub">Your game is not listed. Only someone with the link can join.</p>
			}
			if payload.CreatorName != "" {
				<p class="wait-identity">
					Playing as <strong class="font-semibold text-fg">
						@playerTitle(payload.CreatorTitle)
						<span class="ml-1">{ payload.CreatorName }</span>
					</strong>
					if payload.CreatorRating != "" {
						<span class="rating-chip">{ payload.CreatorRating }</span>
					}
				</p>
			}
		</div>
		<div class="wait-body">
			<section class="wait-panel panel-invite">
				<h2 class="panel-label">Invite a friend</h2>
				// unhidden by lio-room-create.js only where navigator.share exists;
				// hidden by CSS from 40rem up, where the QR + copy already serve
				<button type="button" id="shareInviteButton" class="btn btn-ghost share-btn" hidden title="Share the invite link">
					@iconShare()
					<span>Share invite</span>
				</button>
				<label class="sr-only" for="gameInviteLink">Invite link</label>
				<div class="invite-row">
					<input type="text" id="gameInviteLink" class="invite-field" onClick="this.select();" value={ meta.SiteURL + payload.RoomID } readonly/>
					<button type="button" id="copyInviteButton" class="btn btn-ghost copy-btn" title="Copy invite URL" aria-label="Copy invite URL">
						@iconCopy()
						@iconCheck()
					</button>
					// phones only: the code is inline on desktop, so CSS drops this
					<button type="button" id="qrModalButton" class="btn btn-ghost qr-btn" title="Show QR code" aria-label="Show QR code">
						@iconQR()
					</button>
				</div>
				// One QR, two presentations. Below 40rem this is a real modal that
				// dims the page (opened by #qrModalButton); from 40rem up the CSS
				// collapses the shade and the modal box with display:contents, so
				// the .qr-tile inside becomes a direct flex child of the invite
				// panel and sits inline above the link. Rendering it once this way
				// keeps a single source of truth for the code instead of emitting
				// the SVG twice and risking the copies drifting.
				<div id="modalQR" class="modal-shade">
					<div class="modal qr-modal card">
						<button type="button" class="modal-close" aria-label="Close">@iconClose()</button>
						<h2>Scan to join</h2>
						<div class="qr-tile">
							@inviteQR(meta.SiteURL + payload.RoomID)
						</div>
						<p class="wait-note">Point a phone camera at this code to open the game.</p>
					</div>
				</div>
			</section>
			<section class="wait-panel panel-match">
				<h2 class="panel-label">The match</h2>
				@gameSummary(payload)
			</section>
		</div>
		<div class="wait-foot">
			// The way out for a creator nobody has answered: cancel this
			// challenge and go to the bot picker. Only on a listed challenge;
			// a private one waits for a friend who has the link. The handler
			// redirects to /#vs-computer, which lio-botmodal.js reads.
			if payload.Public {
				<form class="wait-fallback" method="post" action={ "/" + payload.RoomID + "/cancel" } hx-post={ "/" + payload.RoomID + "/cancel" }>
					<input type="hidden" name="cancel_token" value={ payload.CancelToken }/>
					<input type="hidden" name="then" value="computer"/>
					<span>No one yet?</span>
					<button type="submit" class="wait-fallback-btn">Play the computer instead</button>
				</form>
			}
			<form method="post" action={ "/" + payload.RoomID + "/cancel" } hx-post={ "/" + payload.RoomID + "/cancel" }>
				<input type="hidden" name="cancel_token" value={ payload.CancelToken }/>
				<button type="submit" class="btn btn-ghost cancel-ghost" title="Cancel the game">× Cancel game</button>
			</form>
		</div>
	</main>
}

// roomJoiner is the joining player's pre-game view: the same head treatment as
// the creator over the same two-panel body, with the invite panel replaced by
// the opponent panel — who is challenging you, the side they play, and the join
// call-to-action. A rated room swaps the Join button for a "Sign up to play"
// prompt (with a log-in link under it) for guests.
//
// The spec leads in the DOM here, unlike the creator's invite-first order: a
// creator already chose these settings and came back only to share, while a
// joiner is deciding whether to accept, so the stakes — rated, race-to, the
// clock — must come before the button that commits them. Stacked on a phone
// that puts Join last; side by side the columns read the same for both views.
templ roomJoiner(payload message.RoomTemplatePayload) {
	<main class="wait card mt-2 mb-4">
		<div class="wait-head">
			<span class="wait-kicker">You've been challenged</span>
			<div class="waiting-status">
				<span class="waiting-dot" aria-hidden="true"></span>
				<h1 class="wait-title">An opponent is waiting for you</h1>
			</div>
			<p class="wait-sub">The game starts as soon as you join.</p>
		</div>
		<div class="wait-body">
			<section class="wait-panel panel-match">
				<h2 class="panel-label">The match</h2>
				@gameSummary(payload)
			</section>
			<section class="wait-panel panel-opponent">
				<h2 class="panel-label">Your opponent</h2>
				<div class="challenger-card">
					<span class="challenger-name">
						if payload.CreatorName != "" {
							@playerTitle(payload.CreatorTitle)
							{ payload.CreatorName }
							if payload.CreatorRating != "" {
								<span class="rating-chip">{ payload.CreatorRating }</span>
							}
						} else {
							Guest
						}
					</span>
					<span class="challenger-sub">Plays { challengerColorName(payload) }</span>
				</div>
				if payload.Rated && !viewer(ctx).LoggedIn {
					// Sign up leads: somebody who opens a friend's rated link
					// usually has no account yet. Both controls open the account
					// modal on the matching tab (lio-auth.js).
					<div class="wait-join-cta">
						<p class="wait-note mb-2">This is a rated game, so you need an account to play. It takes a username and a password.</p>
						<button type="button" class="btn btn-primary btn-block btn-lg" data-open-register>Sign up to play</button>
						<p class="wait-note mt-2 text-center">Have an account? <button type="button" class="font-semibold text-accent hover:underline cursor-pointer" data-open-login>Log in</button></p>
					</div>
				} else {
					<form class="wait-join-cta" method="post" action={ "/" + payload.RoomID + "/join" } hx-post={ "/" + payload.RoomID + "/join" }>
						<input type="hidden" name="join_token" value={ payload.JoinToken }/>
						<button type="submit" class="btn btn-primary btn-block btn-lg" title="Join the game">Join game</button>
					</form>
				}
			</section>
		</div>
	</main>
}
